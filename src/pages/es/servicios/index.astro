---
// BOLD V1 — hub de Servicios. Markup en src/components/bold/ServicesHub.astro
// (compartido ES/EN); texto en services-hub.es.json + home.es.json.
import Layout from '../../../layouts/Layout.astro';
import ServicesHub from '../../../components/bold/ServicesHub.astro';
import hub from '../../../content/pages/services-hub.es.json';
import home from '../../../content/pages/home.es.json';

export const prerender = true;

const BASE = '/es';
---
<Layout title={hub.title} description={hub.metaDescription} base={BASE} locale="es" altHref="/en/services/" navTheme="dark">
  <ServicesHub hub={hub} home={home} base={BASE} pricingPath="/precios" osPath="/alethig-media-os" />
</Layout>
