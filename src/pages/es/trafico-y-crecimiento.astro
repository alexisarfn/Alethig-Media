---
// BOLD V1 — Traffic & Growth. Markup en src/components/bold/TrafficPage.astro
// (compartido ES/EN); texto en src/content/pages/traffic-growth.es.json.
import Layout from '../../layouts/Layout.astro';
import TrafficPage from '../../components/bold/TrafficPage.astro';
import tg from '../../content/pages/traffic-growth.es.json';

export const prerender = true;

const BASE = '/es';
---
<Layout title={tg.title} description={tg.metaDescription} base={BASE} locale="es" altHref="/en/traffic-growth/" navTheme="dark">
  <TrafficPage tg={tg} base={BASE} pricingPath="/precios" />
</Layout>
