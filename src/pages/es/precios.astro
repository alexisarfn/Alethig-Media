---
// BOLD V1 — Precios con pestañas. Markup en src/components/bold/PricingPage.astro
// (compartido ES/EN); texto en src/content/pages/pricing.es.json.
import Layout from '../../layouts/Layout.astro';
import PricingPage from '../../components/bold/PricingPage.astro';
import pricing from '../../content/pages/pricing.es.json';

export const prerender = true;

const BASE = '/es';
---
<Layout title={pricing.title} description={pricing.metaDescription} base={BASE} locale="es" altHref="/en/pricing/" navTheme="dark">
  <PricingPage p={pricing} base={BASE} />
</Layout>

<script>
  import { initTabs } from '../../scripts/tabs';
  initTabs();
</script>
