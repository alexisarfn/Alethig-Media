---
// CATÁLOGO V1 — Sublimación como catálogo de productos. El markup vive en
// src/components/catalog/SublimationPage.astro (compartido ES/EN); el texto
// en src/content/pages/sublimation.es.json (editable en /admin).
import Layout from '../../layouts/Layout.astro';
import SublimationPage from '../../components/catalog/SublimationPage.astro';
import sub from '../../content/pages/sublimation.es.json';

export const prerender = true;

const BASE = '/es';
---
<Layout title={sub.title} description={sub.metaDescription} base={BASE} locale="es" altHref="/en/sublimation/" navTheme="dark">
  <SublimationPage sub={sub} base={BASE} contactPath="/contacto" pricingPath="/precios" />
</Layout>

<script>
  import { initHomeMotion } from '../../scripts/home-motion';
  import { initCatalogFilter } from '../../scripts/catalog-filter';
  initHomeMotion();
  initCatalogFilter();
</script>
