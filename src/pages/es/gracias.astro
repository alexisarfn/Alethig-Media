---
import Icon from '../../components/Icon.astro';
import Layout from '../../layouts/Layout.astro';
import gracias from '../../content/pages/gracias.es.json';
import { withBase } from '../../lib/basePath';

export const prerender = true;

const BASE = '/es';
---
<Layout title={gracias.title} noindex base={BASE} locale="es" altHref="/en/thank-you/">
  <section class="bg-bg-void relative pt-32 pb-section-py-lg overflow-hidden min-h-[70vh] flex items-center">
    <div class="grid-drift absolute inset-0 pointer-events-none" aria-hidden="true"></div>
    <div class="glow-breathe absolute -top-40 -right-32 w-[34rem] h-[34rem] rounded-full bg-accent/20 blur-[120px] pointer-events-none" aria-hidden="true"></div>
    <div class="glow-breathe absolute -bottom-56 -left-48 w-[30rem] h-[30rem] rounded-full bg-grad-indigo/60 blur-[120px] pointer-events-none" style="animation-delay:2.5s" aria-hidden="true"></div>
    <div class="relative max-w-container-max mx-auto px-gutter w-full">
      <div class="glass lumen-border rounded-2xl p-10 text-center reveal max-w-xl mx-auto">
        <div class="w-14 h-14 rounded-2xl bg-accent/10 border border-accent/20 flex items-center justify-center mx-auto mb-6">
          <Icon name="check_circle" class="text-accent text-3xl" />
        </div>
        <h1 class="uppercase font-display text-headline-lg-mobile md:text-headline-md mb-4">{gracias.heading}</h1>
        <p class="text-text-secondary text-body-md mb-8">{gracias.paragraph}</p>
        <a href={withBase(BASE, '/')} class="btn-cyber-solid shine justify-center press inline-flex">
          <span class="icon-wrap">{gracias.ctaLabel} <Icon name="arrow_forward" class="text-base" /></span>
        <span class="shine-sweep" aria-hidden="true"></span></a>
      </div>
    </div>
  </section>
</Layout>
