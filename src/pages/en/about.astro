---
// NOSOTROS V3 — markup en src/components/about/AboutPage.astro (compartido
// ES/EN); texto en src/content/pages/about.en.json (editable en /admin).
import Layout from '../../layouts/Layout.astro';
import AboutPage from '../../components/about/AboutPage.astro';
import about from '../../content/pages/about.en.json';

export const prerender = true;

const BASE = '/en';
---
<Layout title={about.title} description={about.metaDescription} image={about.heroImage} base={BASE} locale="en" altHref="/es/nosotros/" navTheme="dark">
  <AboutPage about={about} base={BASE} contactPath="/contact" />
</Layout>

<script>
  import { initHomeMotion } from '../../scripts/home-motion';
  initHomeMotion();
</script>
