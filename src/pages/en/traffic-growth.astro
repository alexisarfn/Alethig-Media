---
// BOLD V1 — Traffic & Growth. Markup en src/components/bold/TrafficPage.astro
// (compartido ES/EN); texto en src/content/pages/traffic-growth.en.json.
import Layout from '../../layouts/Layout.astro';
import TrafficPage from '../../components/bold/TrafficPage.astro';
import tg from '../../content/pages/traffic-growth.en.json';

export const prerender = true;

const BASE = '/en';
---
<Layout title={tg.title} description={tg.metaDescription} base={BASE} locale="en" altHref="/es/trafico-y-crecimiento/" navTheme="dark">
  <TrafficPage tg={tg} base={BASE} pricingPath="/pricing" />
</Layout>
