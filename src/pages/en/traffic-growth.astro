---
// POSITIONING PHASE 3 — bespoke page for Traffic & Growth Services (Meta
// Ads, Google Ads, SEO, Local SEO, Lead Generation, Growth Strategy).
// Follows the same "standalone page" pattern already anticipated in
// src/content.config.ts (agentes-ia, embudos-venta, creadores-ugc): its own
// .astro file + its own JSON, outside the uniform services collection. Uses
// the light VISUAL REDESIGN V2 system (same as the homepage), not the dark
// [slug].astro template.
import Icon from '../../components/Icon.astro';
import Layout from '../../layouts/Layout.astro';
import tg from '../../content/pages/traffic-growth.en.json';
import { highlightHeading } from '../../lib/highlight';
import { withBase } from '../../lib/basePath';

export const prerender = true;

const BASE = '/en';

// Decorative hero panel: label-only bars, no numbers/percentages (same
// approach as the homepage's OS "dashboard" panel — see index.astro,
// Alethig Media OS section — to avoid implying real metrics or a product
// screenshot).
// Opacity classes written literally (not interpolated) so Tailwind can
// detect them when scanning this file as text.
const channelBars = [
  { label: 'Meta Ads', width: 'w-4/5', opacity: 'bg-accent/70' },
  { label: 'Google Ads', width: 'w-3/5', opacity: 'bg-accent/60' },
  { label: 'SEO', width: 'w-2/3', opacity: 'bg-accent/50' },
  { label: 'Local SEO', width: 'w-1/2', opacity: 'bg-accent/40' },
  { label: 'Lead Generation', width: 'w-3/4', opacity: 'bg-accent/30' },
];
---
<Layout title={tg.title} description={tg.metaDescription} base={BASE} locale="en" altHref="/es/trafico-y-crecimiento/" navTheme="light">

  <!-- HERO -->
  <section class="on-light mesh-bg-light-hero relative min-h-[85vh] flex items-center pt-28 pb-section-py-sm overflow-hidden">
    <div class="absolute top-1/4 right-1/4 w-96 h-96 rounded-full bg-accent/10 blur-[120px] pointer-events-none"></div>
    <div class="absolute bottom-1/4 left-1/4 w-80 h-80 rounded-full bg-ink/5 blur-[100px] pointer-events-none"></div>
    <div class="max-w-container-max mx-auto px-gutter w-full">
      <div class="grid md:grid-cols-2 gap-12 items-center">
        <div class="hero-reveal">
          <span class="tag-cyber mb-6 inline-flex"><Icon name="monitoring" class="text-sm" />{tg.heroTag}</span>
          <h1 class="font-display text-display-hero-mobile md:text-display-hero-tablet xl:text-display-hero mb-6" set:html={highlightHeading(tg.heroHeading, tg.heroHighlight)}></h1>
          <p class="text-body-lg text-ink-dim mb-8 max-w-xl">{tg.heroParagraph}</p>
          <div class="flex flex-wrap gap-4">
            <!-- Cal.com booking CTA; fallback href goes to Contact. -->
            <a href={withBase(BASE, tg.heroCtaPrimaryHref)} data-booking-trigger class="btn-cyber-solid magnetic press">
              <span class="icon-wrap">{tg.heroCtaPrimaryLabel} <Icon name="calendar_month" class="text-base" /></span>
            </a>
            <a href={withBase(BASE, tg.heroCtaSecondaryHref)} class="btn-ghost magnetic press">{tg.heroCtaSecondaryLabel}</a>
          </div>
        </div>
        <div class="hero-reveal reveal-delay">
          <div class="glass rounded-2xl p-6 md:p-8 border border-accent/15">
            <div class="flex items-center gap-2 mb-6">
              <span class="w-2.5 h-2.5 rounded-full bg-accent/70"></span>
              <span class="w-2.5 h-2.5 rounded-full bg-ink/15"></span>
              <span class="w-2.5 h-2.5 rounded-full bg-ink/15"></span>
            </div>
            <div class="space-y-4">
              {channelBars.map((bar) => (
                <div class="flex items-center gap-3">
                  <div class={`h-2.5 rounded-full ${bar.opacity} ${bar.width}`}></div>
                  <span class="text-ink-dim text-xs font-display whitespace-nowrap">{bar.label}</span>
                </div>
              ))}
            </div>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- SIX CORE MODULES -->
  <section class="on-light section-surface-alt py-section-py-sm md:py-section-py-lg">
    <div class="max-w-container-max mx-auto px-gutter">
      <div class="text-center mb-14 reveal">
        <span class="tag-cyber mb-4 inline-flex">{tg.modulesTag}</span>
        <h2 class="font-display text-headline-lg-mobile md:text-headline-lg mb-4">{tg.modulesHeading}</h2>
        <p class="text-body-md text-ink-dim max-w-2xl mx-auto">{tg.modulesIntro}</p>
      </div>
      <div class="grid sm:grid-cols-2 lg:grid-cols-3 gap-6 stagger-fade">
        {tg.modules.map(m => (
          <div class="glass card-cyber rounded-2xl p-7 relative">
            <span class="editorial-num absolute top-6 right-7" aria-hidden="true">{m.num}</span>
            <div class="w-12 h-12 rounded-xl bg-accent/12 border border-accent/25 flex items-center justify-center mb-4">
              <Icon name={m.icon} class="text-gold-ink text-2xl" />
            </div>
            <h3 class="font-display font-bold text-lg mb-2">{m.title}</h3>
            <p class="text-ink-dim text-sm leading-relaxed mb-3">{m.desc}</p>
            <p class="text-gold-ink text-sm font-display font-semibold leading-relaxed">{m.benefit}</p>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- HOW WE WORK -->
  <section class="on-light section-surface py-section-py-sm md:py-section-py-lg">
    <div class="max-w-container-max mx-auto px-gutter">
      <div class="text-center mb-16 reveal">
        <span class="tag-cyber mb-4 inline-flex">{tg.processTag}</span>
        <h2 class="font-display text-headline-lg-mobile md:text-headline-lg">{tg.processHeading}</h2>
      </div>
      <div class="grid sm:grid-cols-2 lg:grid-cols-4 gap-8 stagger-fade">
        {tg.processSteps.map(step => (
          <div>
            <span class="editorial-num block text-4xl mb-4" style="opacity:0.35">{step.num}</span>
            <h3 class="font-display text-headline-md mb-3">{step.title}</h3>
            <p class="text-ink-dim text-sm leading-relaxed">{step.desc}</p>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- WHO THIS IS FOR -->
  <section class="on-light section-surface-white py-section-py-sm md:py-section-py-lg">
    <div class="max-w-container-max mx-auto px-gutter">
      <div class="text-center mb-4 reveal">
        <span class="tag-cyber mb-4 inline-flex">{tg.fitTag}</span>
        <h2 class="font-display text-headline-lg-mobile md:text-headline-lg mb-4">{tg.fitHeading}</h2>
        <!-- POSITIONING PHASE 1/3: real Long Island reference, not exclusive. -->
        <p class="text-gold-ink font-display font-semibold mb-10 max-w-2xl mx-auto">{tg.fitIntro}</p>
      </div>
      <div class="grid sm:grid-cols-2 lg:grid-cols-3 gap-5 stagger-fade">
        {tg.fitItems.map(item => (
          <div class="glass rounded-2xl p-6 flex gap-4">
            <Icon name={item.icon} class="text-gold-ink text-2xl flex-shrink-0 mt-0.5" />
            <div>
              <h3 class="font-display font-bold text-sm mb-1.5">{item.title}</h3>
              <p class="text-ink-dim text-sm leading-relaxed">{item.desc}</p>
            </div>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- SUPPORTING SERVICES (complementary capabilities, not headline
       offers — only links to real existing service routes). -->
  <section class="on-light section-surface-alt py-section-py-sm">
    <div class="max-w-container-max mx-auto px-gutter">
      <div class="text-center mb-10 reveal">
        <span class="tag-cyber mb-3 inline-flex">{tg.supportTag}</span>
        <h2 class="font-display text-headline-md mb-3">{tg.supportHeading}</h2>
        <p class="text-ink-dim text-sm max-w-xl mx-auto">{tg.supportIntro}</p>
      </div>
      <div class="grid sm:grid-cols-2 lg:grid-cols-5 gap-4 stagger-fade">
        {tg.supportItems.map(item => (
          <a href={withBase(BASE, item.href)} class="glass rounded-xl p-5 flex flex-col items-center text-center gap-3 group">
            <span class="w-10 h-10 rounded-lg bg-accent/10 border border-accent/20 flex items-center justify-center flex-shrink-0">
              <Icon name={item.icon} class="text-gold-ink text-lg" />
            </span>
            <span class="font-display font-semibold text-xs group-hover:text-gold-ink transition-colors duration-300">{item.title}</span>
          </a>
        ))}
      </div>
    </div>
  </section>

  <!-- FINAL CTA -->
  <section class="bg-bg-depth py-section-py-sm">
    <div class="max-w-container-max mx-auto px-gutter">
      <div class="glass lumen-border rounded-3xl p-12 md:p-16 text-center reveal"
           style="background: linear-gradient(135deg, rgba(27,42,107,0.25) 0%, rgba(216,166,42,0.08) 100%);">
        <span class="tag-cyber mb-6 inline-flex">{tg.ctaTag}</span>
        <h2 class="font-display text-headline-lg-mobile md:text-headline-lg mb-5">{tg.ctaHeading}</h2>
        <p class="text-text-secondary text-body-md max-w-xl mx-auto mb-8">{tg.ctaParagraph}</p>
        <div class="flex flex-wrap items-center justify-center gap-4">
          <a href={withBase(BASE, tg.ctaSecondaryHref)} data-booking-trigger class="btn-cyber-solid magnetic press inline-flex">
            <span class="icon-wrap">{tg.ctaButtonLabel} <Icon name={tg.ctaButtonIcon} class="text-base" /></span>
          </a>
          <a href={withBase(BASE, tg.ctaSecondaryHref)} class="btn-ghost magnetic press">{tg.ctaSecondaryLabel}</a>
        </div>
        <!-- POSITIONING PHASE 6: minimal link to the Pricing Hub — plain
             text, no new button, same approach as the "View All Services"
             homepage link from Phase 4. -->
        <p class="mt-6 text-text-dim text-sm">
          <a href={withBase(BASE, '/pricing')} class="text-gold-ink hover:underline">How does pricing work? See Pricing →</a>
        </p>
      </div>
    </div>
  </section>

</Layout>
