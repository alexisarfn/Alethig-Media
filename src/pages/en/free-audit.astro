---
// AUDITORÍA GRATIS — markup en src/components/audit/AuditPage.astro
// (compartido ES/EN); texto en src/content/pages/audit.en.json.
import Layout from '../../layouts/Layout.astro';
import AuditPage from '../../components/audit/AuditPage.astro';
import audit from '../../content/pages/audit.en.json';

export const prerender = true;

const BASE = '/en';
---
<Layout title={audit.title} description={audit.metaDescription} base={BASE} locale="en" altHref="/es/auditoria-gratis/" navTheme="dark">
  <AuditPage a={audit} locale="en" />
</Layout>

<script>
  import { initHomeMotion } from '../../scripts/home-motion';
  initHomeMotion();
</script>
