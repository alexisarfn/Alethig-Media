---
// POSITIONING PHASE 4 — Supporting Services hub. Bespoke standalone page
// (same pattern as traffic-growth.astro / alethig-media-os.astro), NOT
// part of the uniform services collection ([slug].astro stays intact for
// every detail page). Reuses home.en.json.services (already-approved
// copy, no duplication) for the service cards — only the hub's own copy
// (hero, Traffic & Growth callout, categories, CTA) lives in its own JSON.
import Icon from '../../../components/Icon.astro';
import Layout from '../../../layouts/Layout.astro';
import hub from '../../../content/pages/services-hub.en.json';
import home from '../../../content/pages/home.en.json';
import { withBase } from '../../../lib/basePath';

export const prerender = true;

const BASE = '/en';

// Category grouping (Digital Presence / Content & Brand / Paid
// Advertising — handled separately) from the services array already in
// home.en.json, without inventing new routes.
const digitalPresence = home.services.filter(s => s.href.includes('web-development'));
const contentBrand = home.services.filter(s =>
  s.href.includes('brand-design') || s.href.includes('social-media-management') || s.href.includes('video-production')
);
const paidAds = home.services.find(s => s.href.includes('paid-advertising'));
---
<Layout title={hub.title} description={hub.metaDescription} base={BASE} locale="en" altHref="/es/servicios/" navTheme="light">

  <!-- HERO — simpler/centered on purpose compared to the Traffic & Growth
       hero: this hub is a supporting page, it shouldn't visually compete
       with the primary business line (see callout below). -->
  <section class="on-light mesh-bg-light-hero relative pt-32 pb-section-py-lg overflow-hidden min-h-[60vh] flex items-center">
    <div class="absolute top-1/4 right-1/3 w-72 h-72 rounded-full bg-accent/8 blur-[100px] pointer-events-none"></div>
    <div class="max-w-container-max mx-auto px-gutter w-full">
      <div class="glass card-cyber rounded-2xl p-10 md:p-14 text-center reveal max-w-2xl mx-auto">
        <span class="tag-cyber mb-6 inline-flex"><Icon name="design_services" class="text-sm" />{hub.heroTag}</span>
        <h1 class="font-display text-headline-lg-mobile md:text-headline-lg mb-5">{hub.heroHeading}</h1>
        <p class="text-body-lg text-ink-dim mb-10 max-w-xl mx-auto">{hub.heroParagraph}</p>
        <div class="flex flex-wrap items-center justify-center gap-4">
          <a href={withBase(BASE, hub.heroCtaPrimaryHref)} data-booking-trigger class="btn-cyber-solid magnetic press">
            <span class="icon-wrap">{hub.heroCtaPrimaryLabel} <Icon name="calendar_month" class="text-base" /></span>
          </a>
          <a href={withBase(BASE, hub.heroCtaSecondaryHref)} class="btn-ghost magnetic press">{hub.heroCtaSecondaryLabel}</a>
        </div>
      </div>
    </div>
  </section>

  <!-- TRAFFIC & GROWTH CALLOUT — dark background on purpose: the single
       "featured" moment on this page, carrying more visual weight than
       any supporting-service card below (see POSITIONING PHASE 4 §2). -->
  <section class="bg-bg-void relative py-section-py-sm md:py-section-py-lg overflow-hidden">
    <div class="absolute top-1/4 right-[8%] w-96 h-96 rounded-full bg-accent/8 blur-[130px] pointer-events-none"></div>
    <div class="max-w-container-max mx-auto px-gutter relative">
      <div class="glass lumen-border rounded-3xl p-10 md:p-14 reveal"
           style="background: linear-gradient(135deg, rgba(27,42,107,0.25) 0%, rgba(216,166,42,0.08) 100%);">
        <div class="grid md:grid-cols-[1.3fr_1fr] gap-10 items-center">
          <div>
            <span class="tag-cyber mb-5 inline-flex"><Icon name="monitoring" class="text-sm" />{hub.tgCalloutTag}</span>
            <h2 class="font-display text-headline-lg-mobile md:text-headline-lg mb-4">{hub.tgCalloutHeading}</h2>
            <p class="text-text-secondary text-body-md mb-6 max-w-xl">{hub.tgCalloutDesc}</p>
            <ul class="flex flex-wrap gap-2 mb-8">
              {hub.tgCalloutItems.map(item => (
                <li class="text-xs font-display font-semibold text-text-secondary bg-white/5 border border-white/10 rounded-full px-3 py-1.5">{item}</li>
              ))}
            </ul>
            <a href={withBase(BASE, hub.tgCalloutCtaHref)} class="btn-cyber-solid magnetic press inline-flex">
              <span class="icon-wrap">{hub.tgCalloutCtaLabel} <Icon name="arrow_forward" class="text-base" /></span>
            </a>
          </div>
          <div class="hidden md:flex justify-center">
            <div class="w-32 h-32 rounded-full bg-accent/12 border border-accent/25 flex items-center justify-center">
              <Icon name="monitoring" class="text-accent text-6xl" />
            </div>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- DIGITAL PRESENCE -->
  <section class="on-light section-surface-alt py-section-py-sm">
    <div class="max-w-container-max mx-auto px-gutter">
      <div class="mb-8 reveal">
        <span class="tag-cyber mb-3 inline-flex"><Icon name="devices" class="text-sm" />{hub.digitalPresenceTag}</span>
        <p class="text-ink-dim text-sm max-w-xl">{hub.digitalPresenceIntro}</p>
      </div>
      <div class="grid sm:grid-cols-2 lg:grid-cols-3 gap-5 stagger-fade">
        {digitalPresence.map(s => (
          <a href={withBase(BASE, s.href)} class="glass card-cyber rounded-2xl p-6 group block">
            <div class="w-10 h-10 rounded-xl bg-accent/12 border border-accent/25 flex items-center justify-center mb-4 group-hover:bg-accent/20 transition-colors duration-300">
              <Icon name={s.icon} class="text-gold-ink text-xl" />
            </div>
            <h3 class="font-display font-bold text-base mb-2 group-hover:text-gold-ink transition-colors duration-300">{s.title}</h3>
            <p class="text-ink-dim text-sm leading-relaxed mb-4">{s.desc}</p>
            <span class="inline-flex items-center gap-2 text-gold-ink text-xs font-display font-semibold">
              Learn more <Icon name="arrow_forward" class="text-xs transition-transform duration-200 group-hover:translate-x-1" />
            </span>
          </a>
        ))}
      </div>
    </div>
  </section>

  <!-- CONTENT & BRAND -->
  <section class="on-light section-surface py-section-py-sm">
    <div class="max-w-container-max mx-auto px-gutter">
      <div class="mb-8 reveal">
        <span class="tag-cyber mb-3 inline-flex"><Icon name="palette" class="text-sm" />{hub.contentBrandTag}</span>
        <p class="text-ink-dim text-sm max-w-xl">{hub.contentBrandIntro}</p>
      </div>
      <div class="grid sm:grid-cols-2 lg:grid-cols-3 gap-5 stagger-fade">
        {contentBrand.map(s => (
          <a href={withBase(BASE, s.href)} class="glass card-cyber rounded-2xl p-6 group block">
            <div class="w-10 h-10 rounded-xl bg-accent/12 border border-accent/25 flex items-center justify-center mb-4 group-hover:bg-accent/20 transition-colors duration-300">
              <Icon name={s.icon} class="text-gold-ink text-xl" />
            </div>
            <h3 class="font-display font-bold text-base mb-2 group-hover:text-gold-ink transition-colors duration-300">{s.title}</h3>
            <p class="text-ink-dim text-sm leading-relaxed mb-4">{s.desc}</p>
            <span class="inline-flex items-center gap-2 text-gold-ink text-xs font-display font-semibold">
              Learn more <Icon name="arrow_forward" class="text-xs transition-transform duration-200 group-hover:translate-x-1" />
            </span>
          </a>
        ))}
      </div>
    </div>
  </section>

  <!-- PAID ADVERTISING — existing route kept intact, with a note/link
       toward Traffic & Growth to avoid conflicting positioning (see
       POSITIONING PHASE 4 §3). -->
  <section class="on-light section-surface-white py-section-py-sm">
    <div class="max-w-container-max mx-auto px-gutter">
      <div class="mb-8 reveal">
        <span class="tag-cyber mb-3 inline-flex"><Icon name="ads_click" class="text-sm" />{hub.paidAdsTag}</span>
      </div>
      {paidAds && (
        <div class="grid md:grid-cols-[1fr_1.3fr] gap-6 items-stretch stagger-fade">
          <a href={withBase(BASE, paidAds.href)} class="glass card-cyber rounded-2xl p-6 group block">
            <div class="w-10 h-10 rounded-xl bg-accent/12 border border-accent/25 flex items-center justify-center mb-4 group-hover:bg-accent/20 transition-colors duration-300">
              <Icon name={paidAds.icon} class="text-gold-ink text-xl" />
            </div>
            <h3 class="font-display font-bold text-base mb-2 group-hover:text-gold-ink transition-colors duration-300">{paidAds.title}</h3>
            <p class="text-ink-dim text-sm leading-relaxed mb-4">{paidAds.desc}</p>
            <span class="inline-flex items-center gap-2 text-gold-ink text-xs font-display font-semibold">
              Learn more <Icon name="arrow_forward" class="text-xs transition-transform duration-200 group-hover:translate-x-1" />
            </span>
          </a>
          <div class="glass rounded-2xl p-6 flex flex-col justify-center border border-accent/15">
            <p class="text-ink-dim text-sm leading-relaxed mb-4">{hub.paidAdsNote}</p>
            <a href={withBase(BASE, hub.tgCalloutCtaHref)} class="inline-flex items-center gap-2 text-gold-ink text-sm font-display font-semibold w-fit">
              {hub.paidAdsNoteLinkLabel} <Icon name="arrow_forward" class="text-sm" />
            </a>
          </div>
        </div>
      )}
    </div>
  </section>

  <!-- AUTOMATION & SYSTEMS — supporting callout, approved claims only
       (content, approvals, projects, workflows). -->
  <section class="on-light section-surface-alt py-section-py-sm">
    <div class="max-w-container-max mx-auto px-gutter">
      <div class="mb-8 reveal">
        <span class="tag-cyber mb-3 inline-flex"><Icon name="bolt" class="text-sm" />{hub.automationTag}</span>
      </div>
      <div class="glass rounded-2xl p-7 md:p-8 border border-accent/15 grid md:grid-cols-[auto_1fr_auto] gap-6 items-center reveal">
        <div class="w-14 h-14 rounded-2xl bg-accent/12 border border-accent/25 flex items-center justify-center flex-shrink-0">
          <Icon name="bolt" class="text-gold-ink text-2xl" />
        </div>
        <div class="min-w-0">
          <h3 class="font-display font-bold text-lg mb-1.5">{hub.automationHeading}</h3>
          <p class="text-ink-dim text-sm leading-relaxed">{hub.automationBody}</p>
        </div>
        <a href={withBase(BASE, hub.automationCtaHref)} class="btn-ghost magnetic press md:whitespace-nowrap">{hub.automationCtaLabel}</a>
      </div>
    </div>
  </section>

  <!-- LINK TO SUBLIMATION — POSITIONING PHASE 5 §9: Sublimation is a
       primary business line, not another supporting-service card. Its own
       small, gold-bordered callout (distinct from the service grid
       above), just so hub visitors can find it — not mixed into the
       supporting-service cards. -->
  <section class="on-light section-surface py-section-py-sm">
    <div class="max-w-container-max mx-auto px-gutter">
      <a href={withBase(BASE, hub.sublimationCtaHref)} class="glass rounded-2xl p-6 md:p-7 border border-accent/25 flex flex-col sm:flex-row items-center gap-5 sm:gap-6 group reveal">
        <div class="w-12 h-12 rounded-xl bg-accent/12 border border-accent/25 flex items-center justify-center flex-shrink-0">
          <Icon name="checkroom" class="text-gold-ink text-2xl" />
        </div>
        <p class="text-ink-dim text-sm leading-relaxed flex-1 text-center sm:text-left">{hub.sublimationNote}</p>
        <span class="inline-flex items-center gap-2 text-gold-ink text-sm font-display font-semibold sm:whitespace-nowrap">
          {hub.sublimationCtaLabel} <Icon name="arrow_forward" class="text-sm transition-transform duration-200 group-hover:translate-x-1" />
        </span>
      </a>
    </div>
  </section>

  <!-- FINAL CTA -->
  <section class="bg-bg-depth py-section-py-sm">
    <div class="max-w-container-max mx-auto px-gutter">
      <div class="glass lumen-border rounded-3xl p-12 md:p-16 text-center reveal"
           style="background: linear-gradient(135deg, rgba(27,42,107,0.25) 0%, rgba(216,166,42,0.08) 100%);">
        <span class="tag-cyber mb-6 inline-flex">{hub.ctaTag}</span>
        <h2 class="font-display text-headline-lg-mobile md:text-headline-lg mb-5">{hub.ctaHeading}</h2>
        <p class="text-text-secondary text-body-md max-w-xl mx-auto mb-8">{hub.ctaParagraph}</p>
        <div class="flex flex-wrap items-center justify-center gap-4">
          <a href={withBase(BASE, hub.ctaSecondaryHref)} data-booking-trigger class="btn-cyber-solid magnetic press inline-flex">
            <span class="icon-wrap">{hub.ctaButtonLabel} <Icon name={hub.ctaButtonIcon} class="text-base" /></span>
          </a>
          <a href={withBase(BASE, hub.ctaSecondaryHref)} class="btn-ghost magnetic press">{hub.ctaSecondaryLabel}</a>
        </div>
        <!-- POSITIONING PHASE 6: minimal link to the Pricing Hub. -->
        <p class="mt-6 text-text-dim text-sm">
          <a href={withBase(BASE, '/pricing')} class="text-gold-ink hover:underline">How does pricing work? See Pricing →</a>
        </p>
      </div>
    </div>
  </section>

</Layout>
