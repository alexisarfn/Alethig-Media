---
// BOLD V1 — hub de Servicios. Markup en src/components/bold/ServicesHub.astro
// (compartido ES/EN); texto en services-hub.en.json + home.en.json.
import Layout from '../../../layouts/Layout.astro';
import ServicesHub from '../../../components/bold/ServicesHub.astro';
import hub from '../../../content/pages/services-hub.en.json';
import home from '../../../content/pages/home.en.json';

export const prerender = true;

const BASE = '/en';
---
<Layout title={hub.title} description={hub.metaDescription} base={BASE} locale="en" altHref="/es/servicios/" navTheme="dark">
  <ServicesHub hub={hub} home={home} base={BASE} pricingPath="/pricing" osPath="/alethig-media-os" />
</Layout>
