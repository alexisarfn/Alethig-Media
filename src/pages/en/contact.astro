---
import Icon from '../../components/Icon.astro';
import Layout from '../../layouts/Layout.astro';
import contact from '../../content/pages/contact.en.json';
import site from '../../content/settings/site.json';
import siteEn from '../../content/settings/site.en.json';
import { highlightHeading } from '../../lib/highlight';
import { getSrcSet } from '../../lib/responsiveImage';

export const prerender = true;

const BASE = '/en';
const { email } = site.contact;
const { social } = site;
const { contactHours: phone } = siteEn;
const RESPONSIVE_SIZES = '(min-width: 768px) 50vw, 100vw';
---
<Layout title={contact.title} description={contact.metaDescription} image={contact.heroImage} base={BASE} locale="en" altHref="/es/contacto/">

  <!-- HERO -->
  <section class="mesh-bg relative pt-32 pb-section-py-sm overflow-hidden">
    <div class="absolute top-1/4 right-1/3 w-72 h-72 rounded-full bg-accent/5 blur-[100px] pointer-events-none"></div>
    <div class="max-w-container-max mx-auto px-gutter">
      <div class="grid md:grid-cols-2 gap-12 items-center">
        <div class="reveal">
          <span class="tag-cyber mb-5 inline-flex"><Icon name="mail" class="text-sm" />{contact.heroTag}</span>
          <h1 class="uppercase font-display text-display-hero-mobile md:text-5xl font-extrabold mb-5" set:html={highlightHeading(contact.heroHeading, contact.heroHighlight)}></h1>
          <p class="text-body-lg text-text-secondary">
            {contact.heroParagraph}
          </p>
        </div>
        <div class="reveal">
          <div class="glass card-cyber rounded-2xl overflow-hidden animate-float">
            <img
              src={contact.heroImage}
              srcset={getSrcSet(contact.heroImage)}
              sizes={RESPONSIVE_SIZES}
              alt={contact.heroImageAlt}
              class="w-full aspect-square object-cover media-bright"
              fetchpriority="high"
            />
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- FORM SECTION -->
  <section class="bg-bg-depth py-section-py-sm md:py-section-py-lg">
    <div class="max-w-container-max mx-auto px-gutter">
      <div class="grid grid-cols-1 md:grid-cols-2 gap-14 items-start">
        <!-- Left: info -->
        <div class="reveal">
          <h2 class="uppercase font-display text-headline-lg-mobile md:text-headline-md mb-4">{contact.formInfoHeading}</h2>
          <p class="text-text-secondary text-body-md mb-8 leading-relaxed">
            {contact.formInfoText}
          </p>
          <div class="space-y-5 mb-10">
            <div class="flex items-center gap-4">
              <div class="w-10 h-10 rounded-xl bg-accent/10 border border-accent/20 flex items-center justify-center flex-shrink-0">
                <Icon name="mail" class="text-accent text-base" />
              </div>
              <div>
                <p class="text-text-dim text-xs uppercase tracking-widest font-display font-semibold mb-0.5">{contact.infoEmailLabel}</p>
                <a href={`mailto:${email}`} class="text-text-primary text-sm hover:text-accent transition-colors duration-200">{email}</a>
              </div>
            </div>
            <div class="flex items-center gap-4">
              <div class="w-10 h-10 rounded-xl bg-accent/10 border border-accent/20 flex items-center justify-center flex-shrink-0">
                <Icon name="call" class="text-accent text-base" />
              </div>
              <div>
                <p class="text-text-dim text-xs uppercase tracking-widest font-display font-semibold mb-0.5">{contact.infoPhoneLabel}</p>
                <a href={`tel:+${site.whatsapp.number}`} class="text-text-primary text-sm hover:text-accent transition-colors duration-200">{site.whatsapp.display}</a>
              </div>
            </div>
            <div class="flex items-center gap-4">
              <div class="w-10 h-10 rounded-xl bg-accent/10 border border-accent/20 flex items-center justify-center flex-shrink-0">
                <Icon name="schedule" class="text-accent text-base" />
              </div>
              <div>
                <p class="text-text-dim text-xs uppercase tracking-widest font-display font-semibold mb-0.5">{contact.infoHoursLabel}</p>
                <p class="text-text-primary text-sm">{phone}</p>
              </div>
            </div>
          </div>
          <!-- PREMIUM EXPERIENCE V1: additive Cal.com booking CTA — the
               contact form remains the primary path, this is an alternative.
               Fallback href: anchors to the form further down this page. -->
          <div class="mb-10">
            <a href="#contact-nombre" data-booking-trigger class="btn-ghost magnetic press inline-flex items-center gap-2">
              <Icon name="calendar_month" class="text-base" />
              Schedule a Call
            </a>
          </div>
          <div>
            <p class="tag-cyber mb-4">{contact.socialHeading}</p>
            <div class="flex gap-3">
              {social?.instagram && (
                <a href={social.instagram} target="_blank" rel="noopener" class="glass p-3 rounded-xl hover:border-accent/40 transition-all group" aria-label="Instagram">
                  <svg class="w-5 h-5 fill-current text-text-secondary group-hover:text-accent transition-colors" viewBox="0 0 24 24"><path d="M12 2.2c3.2 0 3.6 0 4.9.07 1.2.06 1.8.25 2.2.42.6.22 1 .48 1.4.9.42.4.68.8.9 1.4.17.4.36 1 .42 2.2.06 1.3.07 1.7.07 4.9s0 3.6-.07 4.9c-.06 1.2-.25 1.8-.42 2.2-.22.6-.48 1-.9 1.4-.4.42-.8.68-1.4.9-.4.17-1 .36-2.2.42-1.3.06-1.7.07-4.9.07s-3.6 0-4.9-.07c-1.2-.06-1.8-.25-2.2-.42-.6-.22-1-.48-1.4-.9-.42-.4-.68-.8-.9-1.4-.17-.4-.36-1-.42-2.2C2.2 15.6 2.2 15.2 2.2 12s0-3.6.07-4.9c.06-1.2.25-1.8.42-2.2.22-.6.48-1 .9-1.4.4-.42.8-.68 1.4-.9.4-.17 1-.36 2.2-.42C8.4 2.2 8.8 2.2 12 2.2zm0 1.8c-3.1 0-3.5 0-4.7.07-.9.04-1.4.2-1.7.32-.43.17-.74.37-1.06.7-.32.32-.52.63-.7 1.06-.12.3-.28.8-.32 1.7C3.45 8.5 3.45 8.9 3.45 12s0 3.5.07 4.7c.04.9.2 1.4.32 1.7.17.43.37.74.7 1.06.32.32.63.52 1.06.7.3.12.8.28 1.7.32 1.2.06 1.6.07 4.7.07s3.5 0 4.7-.07c.9-.04 1.4-.2 1.7-.32.43-.17.74-.37 1.06-.7.32-.32.52-.63.7-1.06.12-.3.28-.8.32-1.7.06-1.2.07-1.6.07-4.7s0-3.5-.07-4.7c-.04-.9-.2-1.4-.32-1.7-.17-.43-.37-.74-.7-1.06-.32-.32-.63-.52-1.06-.7-.3-.12-.8-.28-1.7-.32-1.2-.06-1.6-.07-4.7-.07zm0 3.06A4.94 4.94 0 1 1 12 17a4.94 4.94 0 0 1 0-9.88zm0 1.8a3.14 3.14 0 1 0 0 6.28 3.14 3.14 0 0 0 0-6.28zm5.15-3.2a1.15 1.15 0 1 1 0 2.3 1.15 1.15 0 0 1 0-2.3z"/></svg>
                </a>
              )}
              {social?.facebook && (
                <a href={social.facebook} target="_blank" rel="noopener" class="glass p-3 rounded-xl hover:border-accent/40 transition-all group" aria-label="Facebook">
                  <svg class="w-5 h-5 fill-current text-text-secondary group-hover:text-accent transition-colors" viewBox="0 0 24 24"><path d="M22 12a10 10 0 1 0-11.56 9.88v-6.99H7.9V12h2.54V9.8c0-2.5 1.49-3.89 3.78-3.89 1.09 0 2.24.2 2.24.2v2.46h-1.26c-1.24 0-1.63.77-1.63 1.56V12h2.78l-.44 2.89h-2.34v6.99A10 10 0 0 0 22 12z"/></svg>
                </a>
              )}
              {social?.tiktok && (
                <a href={social.tiktok} target="_blank" rel="noopener" class="glass p-3 rounded-xl hover:border-accent/40 transition-all group" aria-label="TikTok">
                  <svg class="w-5 h-5 fill-current text-text-secondary group-hover:text-accent transition-colors" viewBox="0 0 24 24"><path d="M16.6 5.82a4.28 4.28 0 0 1-1.06-2.82h-3.2v12.9a2.59 2.59 0 1 1-2.59-2.59c.27 0 .53.04.77.12v-3.3a5.9 5.9 0 0 0-.77-.05A5.9 5.9 0 1 0 15.65 16V9.6a7.43 7.43 0 0 0 4.35 1.4V7.7a4.28 4.28 0 0 1-3.4-1.88z"/></svg>
                </a>
              )}
            </div>
          </div>
        </div>

        <!-- Right: form -->
        <div class="reveal">
          <div class="glass lumen-border rounded-2xl p-8">
            <div id="form-wrap">
            <!-- !hidden (with important), not hidden: .tag-cyber also sets
                 display (inline-flex) and, since it compiles after
                 Tailwind's utilities, wins the specificity tie against the
                 "hidden" utility — the banner stayed visible always, even
                 on a fresh visit with no ?error=1. -->
            <div id="form-error" class="!hidden tag-cyber !text-red-300 !border-red-400/30 mb-4">
              <Icon name="error" class="text-sm" /> {contact.form.errorMessage}
            </div>
            <form id="contact-form" class="space-y-5" method="POST" action="/api/contact" novalidate>
              <input type="hidden" name="locale" value="en" />
              <div class="absolute left-[-9999px]" aria-hidden="true">
                <label>Leave blank<input type="text" name="website" tabindex="-1" autocomplete="off" /></label>
              </div>
              <div class="grid sm:grid-cols-2 gap-5">
                <div>
                  <label for="contact-nombre" class="block text-text-secondary text-xs uppercase tracking-widest font-display font-semibold mb-2">{contact.form.nameLabel}</label>
                  <input id="contact-nombre" type="text" name="nombre" placeholder={contact.form.namePlaceholder} class="input-cyber" required />
                </div>
                <div>
                  <label for="contact-negocio" class="block text-text-secondary text-xs uppercase tracking-widest font-display font-semibold mb-2">{contact.form.businessLabel}</label>
                  <input id="contact-negocio" type="text" name="negocio" placeholder={contact.form.businessPlaceholder} class="input-cyber" required />
                </div>
              </div>
              <div class="grid sm:grid-cols-2 gap-5">
                <div>
                  <label for="contact-telefono" class="block text-text-secondary text-xs uppercase tracking-widest font-display font-semibold mb-2">{contact.form.phoneLabel}</label>
                  <input id="contact-telefono" type="tel" name="telefono" placeholder={contact.form.phonePlaceholder} class="input-cyber" required />
                </div>
                <div>
                  <label for="contact-email" class="block text-text-secondary text-xs uppercase tracking-widest font-display font-semibold mb-2">{contact.form.emailLabel}</label>
                  <input id="contact-email" type="email" name="email" placeholder={contact.form.emailPlaceholder} class="input-cyber" required />
                </div>
              </div>
              <div>
                <label for="contact-servicio" class="block text-text-secondary text-xs uppercase tracking-widest font-display font-semibold mb-2">{contact.form.serviceLabel}</label>
                <select id="contact-servicio" name="servicio" class="input-cyber">
                  <option value="" disabled selected>{contact.form.servicePlaceholder}</option>
                  {contact.serviceOptions.map(o => (
                    <option value={o.value}>{o.label}</option>
                  ))}
                </select>
              </div>
              <div>
                <label for="contact-mensaje" class="block text-text-secondary text-xs uppercase tracking-widest font-display font-semibold mb-2">{contact.form.messageLabel}</label>
                <textarea id="contact-mensaje" name="mensaje" rows="4" placeholder={contact.form.messagePlaceholder} class="input-cyber resize-none"></textarea>
              </div>
              <div class="cf-turnstile" data-sitekey="0x4AAAAAADyNgzCpNMskdjTs" data-action="turnstile-spin-v1" data-theme="dark" data-size="compact"></div>
              <button type="submit" class="btn-cyber-solid w-full justify-center magnetic press">
                {contact.submitLabel}
              </button>
            </form>
            <div id="form-success" class="hidden text-center py-6">
              <div class="w-14 h-14 rounded-2xl bg-accent/10 border border-accent/20 flex items-center justify-center mx-auto mb-5">
                <Icon name="check_circle" class="text-accent text-3xl" />
              </div>
              <h3 class="uppercase font-display text-headline-lg-mobile mb-2">{contact.form.successHeading}</h3>
              <p class="text-text-secondary text-body-md">{contact.form.successText}</p>
            </div>
            </div>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- MAP STRIP -->
  <section class="mesh-bg-alt py-16">
    <div class="max-w-container-max mx-auto px-gutter flex justify-center">
      <div class="glass lumen-border rounded-2xl px-8 py-5 flex items-center gap-4">
        <Icon name="location_on" class="text-accent text-2xl" />
        <div>
          <p class="font-display font-bold text-text-primary">{contact.mapHeading}</p>
          <p class="text-text-secondary text-sm">{contact.mapText}</p>
        </div>
      </div>
    </div>
  </section>

  <!-- FAQ -->
  <section class="bg-bg-depth py-section-py-sm md:py-section-py-lg">
    <div class="max-w-container-max mx-auto px-gutter">
      <div class="text-center mb-10 reveal">
        <h2 class="uppercase font-display text-headline-lg-mobile md:text-headline-lg">{contact.faqHeading}</h2>
      </div>
      <div class="max-w-3xl mx-auto space-y-3">
        {contact.faq.map((item, i) => (
          <div class="glass rounded-2xl overflow-hidden">
            <h3 class="uppercase m-0">
              <button
                type="button"
                class="faq-trigger w-full flex items-center justify-between gap-4 text-left px-6 py-5"
                aria-expanded="true"
                aria-controls={`faq-panel-${i}`}
                id={`faq-trigger-${i}`}
              >
                <span class="font-body font-semibold text-text-primary text-base md:text-lg">{item.question}</span>
                <Icon name="expand_more" class="text-accent flex-shrink-0 transition-transform duration-200" />
              </button>
            </h3>
            <div id={`faq-panel-${i}`} role="region" aria-labelledby={`faq-trigger-${i}`} class="px-6 pb-5">
              <p class="text-text-secondary text-sm leading-relaxed">{item.answer}</p>
            </div>
          </div>
        ))}
      </div>
    </div>
  </section>

  <script is:inline async defer src="https://challenges.cloudflare.com/turnstile/v0/api.js"></script>

  <script>
    const form = document.getElementById('contact-form') as HTMLFormElement | null;
    const ok = document.getElementById('form-success');
    const err = document.getElementById('form-error');
    const btn = form?.querySelector('button[type=submit]') as HTMLButtonElement | null;

    // Show error if the no-JS fallback redirected with ?error=1
    if (new URLSearchParams(location.search).get('error') === '1') err?.classList.remove('!hidden');

    form?.addEventListener('submit', async (e) => {
      e.preventDefault();
      err?.classList.add('!hidden');
      if (btn) { btn.disabled = true; btn.classList.add('opacity-60'); }
      try {
        const res = await fetch('/api/contact', {
          method: 'POST',
          headers: { 'Accept': 'application/json', 'X-Requested-With': 'fetch' },
          body: new FormData(form),
        });
        const data = await res.json().catch(() => ({ ok: false }));
        if (res.ok && data.ok) {
          form.classList.add('hidden');
          ok?.classList.remove('hidden');
          ok?.scrollIntoView({ behavior: 'smooth', block: 'center' });
        } else {
          throw new Error(data.error || 'fail');
        }
      } catch {
        err?.classList.remove('!hidden');
        // Turnstile token is single-use: reset it to allow retrying.
        (window as any).turnstile?.reset();
      } finally {
        if (btn) { btn.disabled = false; btn.classList.remove('opacity-60'); }
      }
    });
  </script>

  <script>
    // FAQ (accordion): HTML ships with every answer visible (accessible and
    // readable with no JS). If JS loads, panels collapse on init and each
    // button toggles its own panel — same "classList.toggle('hidden')"
    // pattern as the mobile menu in Layout.astro.
    document.querySelectorAll<HTMLButtonElement>('.faq-trigger').forEach((btn) => {
      const panel = document.getElementById(btn.getAttribute('aria-controls') ?? '');
      const icon = btn.querySelector('.icon');
      btn.setAttribute('aria-expanded', 'false');
      panel?.classList.add('hidden');
      btn.addEventListener('click', () => {
        const expanded = btn.getAttribute('aria-expanded') === 'true';
        btn.setAttribute('aria-expanded', String(!expanded));
        panel?.classList.toggle('hidden', expanded);
        icon?.classList.toggle('rotate-180', !expanded);
      });
    });
  </script>

</Layout>
