---
// PRICING IMPLEMENTATION PHASE — Pricing Hub redesigned as a real
// commercial pricing page (previously: an explainer page for "how
// pricing works", with no numbers of its own beyond links to other
// pages). Reuses PlanCard (the same component the service pages already
// use) for the three 3-plan sections — same visual system, no new card
// component invented. Traffic & Growth, Local SEO and Managed Content
// are now real public prices; Websites and Brand Design show as compact
// "Starting at $X" grids (linking to their own page, which keeps its own
// plan detail); Video, Alethig Media OS and Sublimation stay as
// quote/consultation panels — no figures invented beyond what's
// approved (see the pricing-conflict report delivered separately before
// this change).
import Icon from '../../components/Icon.astro';
import Layout from '../../layouts/Layout.astro';
import PlanCard from '../../components/PlanCard.astro';
import pricing from '../../content/pages/pricing.en.json';
import { withBase } from '../../lib/basePath';

export const prerender = true;

const BASE = '/en';
---
<Layout title={pricing.title} description={pricing.metaDescription} base={BASE} locale="en" altHref="/es/precios/" navTheme="light">

  <!-- HERO -->
  <section class="on-light mesh-bg-light-hero relative pt-32 pb-section-py-lg overflow-hidden min-h-[45vh] flex items-center">
    <div class="absolute top-1/4 right-1/3 w-72 h-72 rounded-full bg-accent/8 blur-[100px] pointer-events-none"></div>
    <div class="max-w-container-max mx-auto px-gutter w-full">
      <div class="glass card-cyber rounded-2xl p-10 md:p-14 text-center reveal max-w-2xl mx-auto">
        <span class="tag-cyber mb-6 inline-flex"><Icon name="payments" class="text-sm" />{pricing.heroTag}</span>
        <h1 class="uppercase font-display text-headline-lg-mobile md:text-headline-lg mb-5 break-words">{pricing.heroHeading}</h1>
        <p class="text-body-lg text-ink-dim max-w-xl mx-auto">{pricing.heroParagraph}</p>
      </div>
    </div>
  </section>

  <!-- TRAFFIC & GROWTH — 3 plans -->
  <section class="on-light section-surface-alt py-section-py-sm md:py-section-py-lg">
    <div class="max-w-container-max mx-auto px-gutter">
      <div class="text-center mb-10 reveal">
        <span class="tag-cyber mb-4 inline-flex"><Icon name={pricing.tgIcon} class="text-sm" />{pricing.tgTag}</span>
        <h2 class="uppercase font-display text-headline-lg-mobile md:text-headline-lg mb-4 max-w-2xl mx-auto break-words">{pricing.tgHeading}</h2>
        <p class="text-ink-dim text-body-md max-w-2xl mx-auto">{pricing.tgIntro}</p>
      </div>
      <div class="grid sm:grid-cols-2 lg:grid-cols-3 gap-5 stagger-fade mb-8">
        {pricing.tgPlans.map(p => (
          <PlanCard plan={p} base={BASE} contactHref={pricing.tgCtaHref} featuredLabel="Most Popular" ctaLabel={pricing.tgCtaLabel} />
        ))}
      </div>
      <!-- Ad-spend note + results disclaimer: not part of any single plan,
           applies to all 3 cards. -->
      <div class="text-center max-w-2xl mx-auto space-y-1 mb-8">
        <p class="text-ink font-display uppercase font-semibold text-sm">{pricing.tgAdSpendNote}</p>
        <p class="text-ink-dim text-xs">{pricing.tgDisclaimer}</p>
      </div>
      <div class="flex flex-wrap items-center justify-center gap-4">
        <a href={withBase(BASE, pricing.tgSecondaryHref)} class="btn-ghost magnetic press uppercase">{pricing.tgSecondaryLabel}</a>
      </div>
    </div>
  </section>

  <!-- LOCAL SEO — 3 plans -->
  <section class="on-light section-surface py-section-py-sm md:py-section-py-lg">
    <div class="max-w-container-max mx-auto px-gutter">
      <div class="text-center mb-10 reveal">
        <span class="tag-cyber mb-4 inline-flex"><Icon name={pricing.seoIcon} class="text-sm" />{pricing.seoTag}</span>
        <h2 class="uppercase font-display text-headline-lg-mobile md:text-headline-lg mb-4 max-w-2xl mx-auto break-words">{pricing.seoHeading}</h2>
        <p class="text-ink-dim text-body-md max-w-2xl mx-auto">{pricing.seoIntro}</p>
      </div>
      <div class="grid sm:grid-cols-2 lg:grid-cols-3 gap-5 stagger-fade">
        {pricing.seoPlans.map(p => (
          <PlanCard plan={p} base={BASE} contactHref={pricing.seoCtaHref} featuredLabel="Most Popular" ctaLabel={pricing.seoCtaLabel} />
        ))}
      </div>
    </div>
  </section>

  <!-- MANAGED CONTENT + ALETHIG MEDIA OS — 3 plans -->
  <section class="on-light section-surface-white py-section-py-sm md:py-section-py-lg">
    <div class="max-w-container-max mx-auto px-gutter">
      <div class="text-center mb-10 reveal">
        <span class="tag-cyber mb-4 inline-flex"><Icon name={pricing.contentIcon} class="text-sm" />{pricing.contentTag}</span>
        <h2 class="uppercase font-display text-headline-lg-mobile md:text-headline-lg mb-3 max-w-2xl mx-auto break-words">{pricing.contentHeading}</h2>
        <!-- "Alethig Media OS Included" badge — makes clear the software is
             not a separate charge, without needing its own OS price card
             inside this section. -->
        <span class="inline-flex items-center gap-1.5 text-xs font-display uppercase font-bold text-gold-ink bg-accent/10 border border-accent/25 rounded-full px-3 py-1.5 mb-4">
          <Icon name="bolt" class="text-sm" />{pricing.contentBadge}
        </span>
        <p class="text-ink-dim text-body-md max-w-2xl mx-auto">{pricing.contentIntro}</p>
      </div>
      <div class="grid sm:grid-cols-2 lg:grid-cols-3 gap-5 stagger-fade mb-8">
        {pricing.contentPlans.map(p => (
          <PlanCard plan={p} base={BASE} contactHref={pricing.contentCtaHref} featuredLabel="Most Popular" ctaLabel={pricing.contentCtaLabel} />
        ))}
      </div>
      <div class="flex flex-wrap items-center justify-center gap-4">
        <a href={withBase(BASE, pricing.contentSecondaryHref)} class="btn-ghost magnetic press uppercase">{pricing.contentSecondaryLabel}</a>
      </div>
    </div>
  </section>

  <!-- WEBSITES — compact "Starting at $X" grid -->
  <section class="on-light section-surface-alt py-section-py-sm">
    <div class="max-w-container-max mx-auto px-gutter">
      <div class="glass card-cyber rounded-2xl p-8 md:p-10 reveal">
        <span class="tag-cyber mb-4 inline-flex"><Icon name={pricing.webIcon} class="text-sm" />{pricing.webTag}</span>
        <h2 class="uppercase font-display text-[26px] sm:text-headline-lg-mobile md:text-headline-lg mb-3 max-w-2xl break-words">{pricing.webHeading}</h2>
        <p class="text-ink-dim text-body-md mb-8 max-w-2xl">{pricing.webIntro}</p>
        <div class="grid sm:grid-cols-2 lg:grid-cols-4 gap-4 mb-8">
          {pricing.webItems.map(item => (
            <div class="bg-ink/5 border border-ink/10 rounded-xl p-5 text-center">
              <p class="font-display uppercase font-bold text-sm mb-2">{item.name}</p>
              <p class="gradient-text font-display uppercase font-extrabold text-lg">{item.price}</p>
            </div>
          ))}
        </div>
        <div class="flex flex-wrap gap-4">
          <a href={withBase(BASE, pricing.webCtaHref)} data-booking-trigger class="btn-cyber-solid magnetic press">
            <span class="icon-wrap uppercase">{pricing.webCtaLabel} <Icon name="calendar_month" class="text-base" /></span>
          </a>
          <a href={withBase(BASE, pricing.webSecondaryHref)} class="btn-ghost magnetic press uppercase">{pricing.webSecondaryLabel}</a>
        </div>
      </div>
    </div>
  </section>

  <!-- BRAND DESIGN — compact grid -->
  <section class="on-light section-surface py-section-py-sm">
    <div class="max-w-container-max mx-auto px-gutter">
      <div class="glass card-cyber rounded-2xl p-8 md:p-10 reveal">
        <span class="tag-cyber mb-4 inline-flex"><Icon name={pricing.brandIcon} class="text-sm" />{pricing.brandTag}</span>
        <h2 class="uppercase font-display text-headline-lg-mobile md:text-headline-lg mb-3 max-w-2xl break-words">{pricing.brandHeading}</h2>
        <p class="text-ink-dim text-body-md mb-8 max-w-2xl">{pricing.brandIntro}</p>
        <div class="grid sm:grid-cols-3 gap-4 mb-4">
          {pricing.brandItems.map(item => (
            <div class="bg-ink/5 border border-ink/10 rounded-xl p-5 text-center">
              <p class="font-display uppercase font-bold text-sm mb-2">{item.name}</p>
              <p class="gradient-text font-display uppercase font-extrabold text-lg">{item.price}</p>
            </div>
          ))}
        </div>
        <p class="text-ink-dim text-sm mb-8 max-w-2xl">{pricing.brandNote}</p>
        <div class="flex flex-wrap gap-4">
          <a href={withBase(BASE, pricing.brandCtaHref)} data-booking-trigger class="btn-cyber-solid magnetic press">
            <span class="icon-wrap uppercase">{pricing.brandCtaLabel} <Icon name="calendar_month" class="text-base" /></span>
          </a>
          <a href={withBase(BASE, pricing.brandSecondaryHref)} class="btn-ghost magnetic press uppercase">{pricing.brandSecondaryLabel}</a>
        </div>
      </div>
    </div>
  </section>

  <!-- VIDEO — quote panel, no public pricing table -->
  <section class="on-light section-surface-alt py-section-py-sm">
    <div class="max-w-container-max mx-auto px-gutter">
      <div class="glass card-cyber rounded-2xl p-8 md:p-10 reveal">
        <span class="tag-cyber mb-4 inline-flex"><Icon name={pricing.videoIcon} class="text-sm" />{pricing.videoTag}</span>
        <h2 class="uppercase font-display text-headline-lg-mobile md:text-headline-lg mb-4 max-w-2xl break-words">{pricing.videoHeading}</h2>
        <p class="text-ink-dim text-body-md mb-8 max-w-2xl">{pricing.videoBody}</p>
        <div class="flex flex-wrap gap-4">
          <a href={withBase(BASE, pricing.videoCtaHref)} data-booking-trigger class="btn-cyber-solid magnetic press inline-flex">
            <span class="icon-wrap uppercase">{pricing.videoCtaLabel} <Icon name="send" class="text-base" /></span>
          </a>
          <a href={withBase(BASE, pricing.videoSecondaryHref)} class="btn-ghost magnetic press uppercase">{pricing.videoSecondaryLabel}</a>
        </div>
      </div>
    </div>
  </section>

  <!-- ALETHIG MEDIA OS — "plans coming soon" panel, no public price -->
  <section class="on-light section-surface py-section-py-sm">
    <div class="max-w-container-max mx-auto px-gutter">
      <div class="glass card-cyber rounded-2xl p-8 md:p-10 reveal">
        <span class="tag-cyber mb-4 inline-flex"><Icon name={pricing.osIcon} class="text-sm" />{pricing.osTag}</span>
        <h2 class="uppercase font-display text-headline-lg-mobile md:text-headline-lg mb-4 max-w-2xl break-words">{pricing.osHeading}</h2>
        <p class="text-ink-dim text-body-md mb-6 max-w-2xl">{pricing.osBody}</p>
        <ul class="flex flex-wrap gap-2 mb-8">
          {pricing.osFeatures.map(f => (
            <li class="text-xs font-display uppercase font-semibold text-ink-dim bg-ink/5 border border-ink/10 rounded-full px-3 py-1.5">{f}</li>
          ))}
        </ul>
        <div class="flex flex-wrap gap-4">
          <a href={withBase(BASE, pricing.osCtaHref)} class="btn-cyber-solid magnetic press inline-flex">
            <span class="icon-wrap uppercase">{pricing.osCtaLabel} <Icon name="arrow_forward" class="text-base" /></span>
          </a>
          <a href={withBase(BASE, pricing.osSecondaryHref)} class="btn-ghost magnetic press uppercase">{pricing.osSecondaryLabel}</a>
        </div>
      </div>
    </div>
  </section>

  <!-- SUBLIMATION & BRANDED PRODUCTS — quote panel -->
  <section class="on-light section-surface-alt py-section-py-sm">
    <div class="max-w-container-max mx-auto px-gutter">
      <div class="glass card-cyber rounded-2xl p-8 md:p-10 reveal">
        <span class="tag-cyber mb-4 inline-flex"><Icon name={pricing.subIcon} class="text-sm" />{pricing.subTag}</span>
        <h2 class="uppercase font-display text-headline-lg-mobile md:text-headline-lg mb-4 max-w-2xl break-words">{pricing.subHeading}</h2>
        <p class="text-ink-dim text-body-md mb-6 max-w-2xl">{pricing.subBody}</p>
        <ul class="flex flex-wrap gap-2 mb-8">
          {pricing.subFactors.map(f => (
            <li class="text-xs font-display uppercase font-semibold text-ink-dim bg-ink/5 border border-ink/10 rounded-full px-3 py-1.5">{f}</li>
          ))}
        </ul>
        <div class="flex flex-wrap gap-4">
          <a href={withBase(BASE, pricing.subCtaHref)} class="btn-cyber-solid magnetic press inline-flex">
            <span class="icon-wrap uppercase">{pricing.subCtaLabel} <Icon name="send" class="text-base" /></span>
          </a>
          <a href={withBase(BASE, pricing.subSecondaryHref)} class="btn-ghost magnetic press uppercase">{pricing.subSecondaryLabel}</a>
        </div>
      </div>
    </div>
  </section>

  <!-- REGIONAL PRICING NOTE -->
  <section class="on-light section-surface py-section-py-sm">
    <div class="max-w-container-max mx-auto px-gutter">
      <div class="flex items-center justify-center gap-3 text-center reveal">
        <Icon name={pricing.regionIcon} class="text-gold-ink text-xl flex-shrink-0" />
        <p class="text-ink-dim text-sm max-w-xl">{pricing.regionNote}</p>
      </div>
    </div>
  </section>

  <!-- FINAL CTA -->
  <section class="bg-bg-depth py-section-py-sm">
    <div class="max-w-container-max mx-auto px-gutter">
      <div class="glass lumen-border rounded-3xl p-12 md:p-16 text-center reveal"
           style="background: linear-gradient(135deg, rgba(27,42,107,0.25) 0%, rgba(216,166,42,0.08) 100%);">
        <span class="tag-cyber mb-6 inline-flex">{pricing.ctaTag}</span>
        <h2 class="uppercase font-display text-headline-lg-mobile md:text-headline-lg mb-5 break-words">{pricing.ctaHeading}</h2>
        <p class="text-text-secondary text-body-md max-w-xl mx-auto mb-8">{pricing.ctaParagraph}</p>
        <div class="flex flex-wrap items-center justify-center gap-4">
          <a href={withBase(BASE, pricing.ctaSecondaryHref)} data-booking-trigger class="btn-cyber-solid magnetic press inline-flex">
            <span class="icon-wrap uppercase">{pricing.ctaButtonLabel} <Icon name={pricing.ctaButtonIcon} class="text-base" /></span>
          </a>
          <a href={withBase(BASE, pricing.ctaSecondaryHref)} class="btn-ghost magnetic press uppercase">{pricing.ctaSecondaryLabel}</a>
        </div>
      </div>
    </div>
  </section>

</Layout>
