---
// POSITIONING PHASE 6 — Pricing Hub. Bespoke standalone page (same
// pattern as traffic-growth.astro / services-hub / sublimation.astro),
// outside the uniform services collection. Explains HOW pricing works
// across the 4 business lines without inventing figures that don't
// exist: Traffic & Growth and Alethig Media OS have no public pricing
// (consultation/package-based); Sublimation is quote-based; Supporting
// Services DO have real plans/pricing already published on their own
// pages (see audit in src/content/services/es/*.json) — this hub links
// to those pages instead of duplicating the values.
import Icon from '../../components/Icon.astro';
import Layout from '../../layouts/Layout.astro';
import pricing from '../../content/pages/pricing.en.json';
import { withBase } from '../../lib/basePath';

export const prerender = true;

const BASE = '/en';
---
<Layout title={pricing.title} description={pricing.metaDescription} base={BASE} locale="en" altHref="/es/precios/" navTheme="light">

  <!-- HERO — centered and simple (same pattern as the Services hub): this
       page is a guide/decision aid, not its own business line, so it
       shouldn't visually compete with Traffic & Growth/Sublimation. -->
  <section class="on-light mesh-bg-light-hero relative pt-32 pb-section-py-lg overflow-hidden min-h-[55vh] flex items-center">
    <div class="absolute top-1/4 right-1/3 w-72 h-72 rounded-full bg-accent/8 blur-[100px] pointer-events-none"></div>
    <div class="max-w-container-max mx-auto px-gutter w-full">
      <div class="glass card-cyber rounded-2xl p-10 md:p-14 text-center reveal max-w-2xl mx-auto">
        <span class="tag-cyber mb-6 inline-flex"><Icon name="payments" class="text-sm" />{pricing.heroTag}</span>
        <h1 class="font-display text-headline-lg-mobile md:text-headline-lg mb-5 break-words">{pricing.heroHeading}</h1>
        <p class="text-body-lg text-ink-dim max-w-xl mx-auto">{pricing.heroParagraph}</p>
      </div>
    </div>
  </section>

  <!-- 01 · TRAFFIC & GROWTH -->
  <section class="on-light section-surface-alt py-section-py-sm">
    <div class="max-w-container-max mx-auto px-gutter">
      <div class="glass card-cyber rounded-2xl p-8 md:p-10 relative reveal">
        <span class="editorial-num absolute top-6 right-7" aria-hidden="true">{pricing.tgNum}</span>
        <span class="tag-cyber mb-4 inline-flex"><Icon name={pricing.tgIcon} class="text-sm" />{pricing.tgTag}</span>
        <h2 class="font-display text-headline-lg-mobile md:text-headline-lg mb-4 max-w-2xl break-words">{pricing.tgHeading}</h2>
        <p class="text-ink-dim text-body-md mb-6 max-w-2xl">{pricing.tgBody}</p>
        <ul class="flex flex-wrap gap-2 mb-8">
          {pricing.tgFactors.map(f => (
            <li class="text-xs font-display font-semibold text-ink-dim bg-ink/5 border border-ink/10 rounded-full px-3 py-1.5">{f}</li>
          ))}
        </ul>
        <div class="flex flex-wrap gap-4">
          <a href={withBase(BASE, pricing.tgCtaHref)} data-booking-trigger class="btn-cyber-solid magnetic press">
            <span class="icon-wrap">{pricing.tgCtaLabel} <Icon name="calendar_month" class="text-base" /></span>
          </a>
          <a href={withBase(BASE, pricing.tgSecondaryHref)} class="btn-ghost magnetic press">{pricing.tgSecondaryLabel}</a>
        </div>
      </div>
    </div>
  </section>

  <!-- 02 · SUPPORTING SERVICES -->
  <section class="on-light section-surface py-section-py-sm">
    <div class="max-w-container-max mx-auto px-gutter">
      <div class="glass card-cyber rounded-2xl p-8 md:p-10 relative reveal">
        <span class="editorial-num absolute top-6 right-7" aria-hidden="true">{pricing.supportNum}</span>
        <span class="tag-cyber mb-4 inline-flex"><Icon name={pricing.supportIcon} class="text-sm" />{pricing.supportTag}</span>
        <h2 class="font-display text-headline-lg-mobile md:text-headline-lg mb-4 max-w-2xl break-words">{pricing.supportHeading}</h2>
        <p class="text-ink-dim text-body-md mb-8 max-w-2xl">{pricing.supportBody}</p>
        <a href={withBase(BASE, pricing.supportCtaHref)} class="btn-cyber-solid magnetic press inline-flex">
          <span class="icon-wrap">{pricing.supportCtaLabel} <Icon name="arrow_forward" class="text-base" /></span>
        </a>
      </div>
    </div>
  </section>

  <!-- 03 · ALETHIG MEDIA OS -->
  <section class="on-light section-surface-white py-section-py-sm">
    <div class="max-w-container-max mx-auto px-gutter">
      <div class="glass card-cyber rounded-2xl p-8 md:p-10 relative reveal">
        <span class="editorial-num absolute top-6 right-7" aria-hidden="true">{pricing.osNum}</span>
        <span class="tag-cyber mb-4 inline-flex"><Icon name={pricing.osIcon} class="text-sm" />{pricing.osTag}</span>
        <h2 class="font-display text-headline-lg-mobile md:text-headline-lg mb-4 max-w-2xl break-words">{pricing.osHeading}</h2>
        <p class="text-ink-dim text-body-md mb-8 max-w-2xl">{pricing.osBody}</p>
        <div class="flex flex-wrap gap-4">
          <a href={withBase(BASE, pricing.osCtaHref)} class="btn-cyber-solid magnetic press inline-flex">
            <span class="icon-wrap">{pricing.osCtaLabel} <Icon name="arrow_forward" class="text-base" /></span>
          </a>
          <a href={withBase(BASE, pricing.osSecondaryHref)} class="btn-ghost magnetic press">{pricing.osSecondaryLabel}</a>
        </div>
      </div>
    </div>
  </section>

  <!-- 04 · SUBLIMATION & BRANDED PRODUCTS -->
  <section class="on-light section-surface-alt py-section-py-sm">
    <div class="max-w-container-max mx-auto px-gutter">
      <div class="glass card-cyber rounded-2xl p-8 md:p-10 relative reveal">
        <span class="editorial-num absolute top-6 right-7" aria-hidden="true">{pricing.subNum}</span>
        <span class="tag-cyber mb-4 inline-flex"><Icon name={pricing.subIcon} class="text-sm" />{pricing.subTag}</span>
        <h2 class="font-display text-headline-lg-mobile md:text-headline-lg mb-4 max-w-2xl break-words">{pricing.subHeading}</h2>
        <p class="text-ink-dim text-body-md mb-6 max-w-2xl">{pricing.subBody}</p>
        <ul class="flex flex-wrap gap-2 mb-8">
          {pricing.subFactors.map(f => (
            <li class="text-xs font-display font-semibold text-ink-dim bg-ink/5 border border-ink/10 rounded-full px-3 py-1.5">{f}</li>
          ))}
        </ul>
        <div class="flex flex-wrap gap-4">
          <a href={withBase(BASE, pricing.subCtaHref)} class="btn-cyber-solid magnetic press inline-flex">
            <span class="icon-wrap">{pricing.subCtaLabel} <Icon name="send" class="text-base" /></span>
          </a>
          <a href={withBase(BASE, pricing.subSecondaryHref)} class="btn-ghost magnetic press">{pricing.subSecondaryLabel}</a>
        </div>
      </div>
    </div>
  </section>

  <!-- REGION NOTE — architecture designed to expand to US/Mexico/other
       regions later, with no empty tabs or invented figures today. -->
  <section class="on-light section-surface py-section-py-sm">
    <div class="max-w-container-max mx-auto px-gutter">
      <div class="flex items-center justify-center gap-3 text-center reveal">
        <Icon name={pricing.regionIcon} class="text-gold-ink text-xl flex-shrink-0" />
        <p class="text-ink-dim text-sm max-w-xl">{pricing.regionNote}</p>
      </div>
    </div>
  </section>

  <!-- FINAL CTA -->
  <section class="bg-bg-depth py-section-py-sm">
    <div class="max-w-container-max mx-auto px-gutter">
      <div class="glass lumen-border rounded-3xl p-12 md:p-16 text-center reveal"
           style="background: linear-gradient(135deg, rgba(27,42,107,0.25) 0%, rgba(216,166,42,0.08) 100%);">
        <span class="tag-cyber mb-6 inline-flex">{pricing.ctaTag}</span>
        <h2 class="font-display text-headline-lg-mobile md:text-headline-lg mb-5 break-words">{pricing.ctaHeading}</h2>
        <p class="text-text-secondary text-body-md max-w-xl mx-auto mb-8">{pricing.ctaParagraph}</p>
        <div class="flex flex-wrap items-center justify-center gap-4">
          <a href={withBase(BASE, pricing.ctaSecondaryHref)} data-booking-trigger class="btn-cyber-solid magnetic press inline-flex">
            <span class="icon-wrap">{pricing.ctaButtonLabel} <Icon name={pricing.ctaButtonIcon} class="text-base" /></span>
          </a>
          <a href={withBase(BASE, pricing.ctaSecondaryHref)} class="btn-ghost magnetic press">{pricing.ctaSecondaryLabel}</a>
        </div>
      </div>
    </div>
  </section>

</Layout>
