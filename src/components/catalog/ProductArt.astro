---
// CATÁLOGO V1 — ilustración SVG de cada producto sublimable (una por tipo de
// la máquina 8 en 1). No hay fotos reales de producto en el repo: esto evita
// usar stock genérico y deja espacio para reemplazarlas con fotos reales
// (campo `image` del producto en sublimation.<locale>.json — si existe, la
// tarjeta muestra la foto y no este dibujo).
//
// La pieza "teñible" lleva .dye-part: cambia de color al pasar el mouse por
// la tarjeta (ver .product-card en global.css), o en loop si se pasa
// animate={true}.
interface Props {
  kind: 'tshirt' | 'hoodie' | 'cap' | 'mug' | 'tumbler' | 'mousepad' | 'notebook';
  word: string;
  animate?: boolean;
  class?: string;
}
const { kind, word, animate = false, class: className = '' } = Astro.props;
const dye = animate ? 'dye' : 'dye-part';
const label = 'font-family:var(--font-display);fill:var(--bg-void)';
const line = 'stroke:var(--surface-white)';
---
<svg class={className} viewBox="0 0 120 120" aria-hidden="true">
  {kind === 'tshirt' && (
    <g>
      <path class={dye} d="M40 14 L20 24 L8 46 L24 54 L28 46 L28 108 L92 108 L92 46 L96 54 L112 46 L100 24 L80 14 C76 24 68 28 60 28 C52 28 44 24 40 14 Z" stroke-width="1.6" style={line}></path>
      <text x="60" y="66" text-anchor="middle" font-weight="800" font-size="8" style={label}>{word}</text>
    </g>
  )}
  {kind === 'hoodie' && (
    <g>
      <path class={dye} d="M42 14 L18 24 L6 72 L20 76 L28 46 L28 108 L92 108 L92 46 L100 76 L114 72 L102 24 L78 14 C76 26 68 32 60 32 C52 32 44 26 42 14 Z" stroke-width="1.6" style={line}></path>
      <path d="M44 14 C46 30 74 30 76 14" fill="none" stroke-width="1.6" style={line}></path>
      <rect x="42" y="84" width="36" height="16" rx="4" fill="none" stroke-width="1.4" style="stroke:var(--bg-void);opacity:.35"></rect>
      <text x="60" y="66" text-anchor="middle" font-weight="800" font-size="8" style={label}>{word}</text>
    </g>
  )}
  {kind === 'cap' && (
    <g>
      <path class={dye} d="M20 74 C20 44 38 30 60 30 C82 30 100 44 100 74 Z" stroke-width="1.6" style={line}></path>
      <path d="M14 74 L106 74 C106 82 96 86 60 86 C24 86 14 82 14 74 Z" style="fill:var(--surface-white)"></path>
      <circle cx="60" cy="30" r="3.5" style="fill:var(--surface-white)"></circle>
      <text x="60" y="62" text-anchor="middle" font-weight="800" font-size="7" style={label}>{word}</text>
    </g>
  )}
  {kind === 'mug' && (
    <g>
      <rect x="22" y="28" width="62" height="70" rx="8" style="fill:var(--surface-white)"></rect>
      <path d="M84 44 h9 a13 13 0 0 1 0 26 h-9" fill="none" stroke-width="8" style={line}></path>
      <rect class={dye} x="22" y="50" width="62" height="26"></rect>
      <text x="53" y="66" text-anchor="middle" font-weight="800" font-size="7" style={label}>{word}</text>
    </g>
  )}
  {kind === 'tumbler' && (
    <g>
      <rect x="38" y="14" width="44" height="10" rx="3" style="fill:var(--surface-white)"></rect>
      <path class={dye} d="M38 26 L82 26 L76 106 L44 106 Z" stroke-width="1.6" style={line}></path>
      <text x="60" y="70" text-anchor="middle" font-weight="800" font-size="6.5" style={label}>{word}</text>
    </g>
  )}
  {kind === 'mousepad' && (
    <g>
      <rect class={dye} x="14" y="30" width="92" height="64" rx="10" stroke-width="1.6" style={line}></rect>
      <path d="M78 52 a10 14 0 0 1 20 0 v12 a10 14 0 0 1 -20 0 Z" style="fill:var(--surface-white)"></path>
      <text x="44" y="66" text-anchor="middle" font-weight="800" font-size="7" style={label}>{word}</text>
    </g>
  )}
  {kind === 'notebook' && (
    <g>
      <rect class={dye} x="30" y="16" width="64" height="90" rx="6" stroke-width="1.6" style={line}></rect>
      {[26, 38, 50, 62, 74, 86, 98].map(y => <circle cx="30" cy={y} r="3" style="fill:var(--surface-white)"></circle>)}
      <text x="62" y="64" text-anchor="middle" font-weight="800" font-size="7" style={label}>{word}</text>
    </g>
  )}
</svg>
