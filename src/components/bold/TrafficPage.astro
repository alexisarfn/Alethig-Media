---
// BOLD V1 — Traffic & Growth (compartido ES/EN; texto en
// traffic-growth.<locale>.json). Hero con embudo animado, texto gigante en
// movimiento, módulos en grilla "bento" con mini-visuales, proceso en línea
// de tiempo, CTA con borde giratorio.
import Icon from '../Icon.astro';
import MegaMarquee from './MegaMarquee.astro';
import TrafficVisual from './TrafficVisual.astro';
import { highlightHeading } from '../../lib/highlight';
import { withBase } from '../../lib/basePath';

interface Props { tg: any; base: string; pricingPath: string }
const { tg, base, pricingPath } = Astro.props;
const kinds = ['meta', 'google', 'seo', 'local', 'leads', 'growth'];
const spans = ['lg:col-span-2', '', '', '', '', 'lg:col-span-3'];
const widths = [100, 90, 80, 70];
---
<!-- HERO -->
<section class="bg-bg-void relative min-h-screen flex items-center pt-28 md:pt-32 pb-section-py-sm overflow-hidden">
  <div class="grid-drift absolute inset-0 pointer-events-none" aria-hidden="true"></div>
  <div class="glow-breathe absolute -top-48 right-[10%] w-[40rem] h-[40rem] rounded-full bg-accent/20 blur-[130px] pointer-events-none" aria-hidden="true"></div>
  <div class="glow-breathe absolute -bottom-56 -left-48 w-[32rem] h-[32rem] rounded-full bg-grad-indigo/70 blur-[120px] pointer-events-none" style="animation-delay:2.5s" aria-hidden="true"></div>
  <div class="relative max-w-container-max mx-auto px-gutter w-full">
    <div class="grid grid-cols-1 lg:grid-cols-[1.1fr_1fr] gap-14 items-center">
      <div class="hero-reveal min-w-0">
        <span class="tag-cyber mb-6 inline-flex items-center gap-2"><span class="pulse-ring w-2 h-2 rounded-full bg-accent" aria-hidden="true"></span>{tg.heroTag}</span>
        <h1 class="uppercase font-display font-extrabold text-text-primary tracking-[-0.03em] leading-[0.98] text-[40px] sm:text-[54px] lg:text-[64px] xl:text-[76px] mb-7 break-words" set:html={highlightHeading(tg.heroHeading, tg.heroHighlight)}></h1>
        <p class="text-body-lg text-text-secondary mb-9 max-w-xl">{tg.heroParagraph}</p>
        <div class="flex flex-wrap gap-4">
          <a href={withBase(base, tg.heroCtaPrimaryHref)} data-booking-trigger class="btn-cyber-solid shine magnetic press !py-4 !px-8">
            <span class="icon-wrap uppercase">{tg.heroCtaPrimaryLabel} <Icon name="calendar_month" class="text-base" /></span>
            <span class="shine-sweep" aria-hidden="true"></span>
          </a>
          <a href="#modulos" class="btn-ghost magnetic press uppercase !py-4">{tg.heroCtaSecondaryLabel}</a>
        </div>
      </div>

      <!-- Embudo animado -->
      <div class="hero-reveal reveal-delay min-w-0">
        <div class="glow-border glass rounded-3xl p-6 md:p-8 bg-bg-void/70">
          <p class="text-xs font-display uppercase font-bold tracking-[0.2em] text-accent mb-6 flex items-center gap-2"><span class="pulse-ring w-2 h-2 rounded-full bg-accent"></span>{tg.funnelLabel}</p>
          <div class="relative flex flex-col items-center gap-3 py-2">
            <div class="absolute inset-x-0 top-0 h-full flex justify-center pointer-events-none" aria-hidden="true">
              {[0, 1, 2, 3, 4].map(i => (
                <span class="funnel-dot" style={`left:calc(50% + ${(i - 2) * 14}px);animation-delay:${i * 0.7}s`}></span>
              ))}
            </div>
            {tg.funnelStages.map((s: any, i: number) => (
              <div class="relative rounded-xl border border-accent/30 flex items-center justify-between gap-3 px-4 md:px-5 py-4 transition-colors"
                   style={`width:${widths[i]}%;background:rgba(var(--accent-rgb),${0.08 + i * 0.1})`}>
                <span class="flex items-center gap-3 min-w-0">
                  <Icon name={s.icon} class="text-accent text-xl shrink-0" />
                  <span class="flex flex-col min-w-0">
                    <span class="font-display uppercase text-xs md:text-sm text-text-primary leading-tight">{s.label}</span>
                    <span class="text-[11px] text-text-secondary">{s.hint}</span>
                  </span>
                </span>
                <span class="font-display text-accent/60 text-sm" aria-hidden="true">0{i + 1}</span>
              </div>
            ))}
          </div>
        </div>
      </div>
    </div>
  </div>
</section>

<MegaMarquee words={tg.megaWords} />

<!-- MÓDULOS — bento -->
<section id="modulos" class="bg-bg-void relative py-section-py-sm md:py-section-py-lg scroll-mt-24 overflow-hidden">
  <div class="max-w-container-max mx-auto px-gutter">
    <div class="grid lg:grid-cols-[1fr_1fr] gap-6 items-end mb-12 reveal">
      <div>
        <span class="tag-cyber mb-4 inline-flex">{tg.modulesTag}</span>
        <h2 class="uppercase font-display font-extrabold text-text-primary text-[32px] md:text-[52px] leading-[1.02]">{tg.modulesHeading}</h2>
      </div>
      <p class="text-body-md text-text-secondary lg:text-right">{tg.modulesIntro}</p>
    </div>
    <div class="grid sm:grid-cols-2 lg:grid-cols-3 gap-5">
      {tg.modules.map((m: any, i: number) => (
        <article class={`tilt spot reveal rounded-3xl border border-white/10 bg-white/[0.03] p-6 md:p-7 flex flex-col gap-5 ${spans[i] ?? ''} ${i === 5 ? 'lg:grid lg:grid-cols-[1fr_1.3fr] lg:items-center' : ''}`}>
          <TrafficVisual kind={kinds[i] ?? 'growth'} labels={tg.visualLabels} />
          <div>
            <div class="flex items-center justify-between mb-3">
              <span class="w-11 h-11 rounded-xl bg-accent/12 border border-accent/30 flex items-center justify-center"><Icon name={m.icon} class="text-accent text-xl" /></span>
              <span class="font-display text-3xl text-white/15">{m.num}</span>
            </div>
            <h3 class="uppercase font-display font-bold text-xl text-text-primary mb-2">{m.title}</h3>
            <p class="text-text-secondary text-sm leading-relaxed mb-3">{m.desc}</p>
            <p class="text-accent text-xs font-display uppercase font-semibold leading-relaxed">{m.benefit}</p>
          </div>
        </article>
      ))}
    </div>
  </div>
</section>

<!-- PROCESO -->
<section class="on-light section-surface-white py-section-py-sm md:py-section-py-lg">
  <div class="max-w-container-max mx-auto px-gutter">
    <div class="text-center mb-14 reveal">
      <span class="tag-cyber mb-4 inline-flex">{tg.processTag}</span>
      <h2 class="uppercase font-display text-headline-lg-mobile md:text-headline-lg">{tg.processHeading}</h2>
    </div>
    <ol class="relative grid md:grid-cols-4 gap-6 stagger-fade">
      <span class="hidden md:block absolute left-0 right-0 top-7 h-0.5 bg-ink/10" aria-hidden="true"></span>
      <span class="bar-grow hidden md:block absolute left-0 right-0 top-7 h-0.5 bg-accent" aria-hidden="true"></span>
      {tg.processSteps.map((step: any) => (
        <li class="relative">
          <span class="relative z-10 w-14 h-14 rounded-full bg-bg-void text-accent font-display text-lg flex items-center justify-center mb-5 shadow-lg pulse-ring">{step.num}</span>
          <h3 class="uppercase font-display font-bold text-lg mb-2">{step.title}</h3>
          <p class="text-ink-dim text-sm leading-relaxed">{step.desc}</p>
        </li>
      ))}
    </ol>
  </div>
</section>

<!-- PARA QUIÉN -->
<section class="on-light section-surface-alt py-section-py-sm md:py-section-py-lg">
  <div class="max-w-container-max mx-auto px-gutter">
    <div class="text-center mb-12 reveal">
      <span class="tag-cyber mb-4 inline-flex">{tg.fitTag}</span>
      <h2 class="uppercase font-display text-headline-lg-mobile md:text-headline-lg mb-4">{tg.fitHeading}</h2>
      <p class="text-gold-ink font-display uppercase font-semibold max-w-2xl mx-auto">{tg.fitIntro}</p>
    </div>
    <div class="grid sm:grid-cols-2 lg:grid-cols-3 gap-5 stagger-fade">
      {tg.fitItems.map((item: any) => (
        <div class="tilt spot rounded-2xl p-6 flex gap-4 bg-surface-white border border-ink/10 hover:border-accent/50 transition-colors">
          <span class="w-12 h-12 rounded-xl bg-bg-void flex items-center justify-center shrink-0"><Icon name={item.icon} class="text-accent text-2xl" /></span>
          <div>
            <h3 class="uppercase font-display font-bold text-sm mb-1.5">{item.title}</h3>
            <p class="text-ink-dim text-sm leading-relaxed">{item.desc}</p>
          </div>
        </div>
      ))}
    </div>
  </div>
</section>

<!-- APOYO -->
<section class="on-light section-surface py-section-py-sm">
  <div class="max-w-container-max mx-auto px-gutter">
    <div class="text-center mb-10 reveal">
      <span class="tag-cyber mb-3 inline-flex">{tg.supportTag}</span>
      <h2 class="uppercase font-display text-headline-md mb-3">{tg.supportHeading}</h2>
      <p class="text-ink-dim text-sm max-w-xl mx-auto">{tg.supportIntro}</p>
    </div>
    <div class="flex flex-wrap justify-center gap-3 stagger-fade">
      {tg.supportItems.map((item: any) => (
        <a href={withBase(base, item.href)} class="group inline-flex items-center gap-3 rounded-full bg-surface-white border border-ink/10 pl-2 pr-5 py-2 hover:bg-bg-void hover:border-bg-void transition-colors duration-300">
          <span class="w-9 h-9 rounded-full bg-accent/15 flex items-center justify-center"><Icon name={item.icon} class="text-gold-ink group-hover:text-accent text-lg" /></span>
          <span class="font-display uppercase font-semibold text-xs text-ink group-hover:text-text-primary">{item.title}</span>
          <Icon name="arrow_forward" class="text-sm text-gold-ink group-hover:text-accent group-hover:translate-x-1 transition-transform" />
        </a>
      ))}
    </div>
  </div>
</section>

<!-- CTA -->
<section class="bg-bg-void relative py-section-py-sm md:py-section-py-lg overflow-hidden">
  <div class="grid-drift absolute inset-0 pointer-events-none" aria-hidden="true"></div>
  <div class="relative max-w-4xl mx-auto px-gutter">
    <div class="glow-border rounded-3xl bg-bg-depth/80 p-10 md:p-16 text-center reveal">
      <span class="tag-cyber mb-6 inline-flex">{tg.ctaTag}</span>
      <h2 class="uppercase font-display font-extrabold text-text-primary text-[30px] md:text-[52px] leading-[1.02] mb-5">{tg.ctaHeading}</h2>
      <p class="text-text-secondary text-body-md max-w-xl mx-auto mb-9">{tg.ctaParagraph}</p>
      <div class="flex flex-wrap items-center justify-center gap-4">
        <a href={withBase(base, tg.ctaSecondaryHref)} data-booking-trigger class="btn-cyber-solid shine pulse-ring magnetic press !py-4 !px-8">
          <span class="icon-wrap uppercase">{tg.ctaButtonLabel} <Icon name={tg.ctaButtonIcon} class="text-base" /></span>
          <span class="shine-sweep" aria-hidden="true"></span>
        </a>
        <a href={withBase(base, tg.ctaSecondaryHref)} class="btn-ghost magnetic press uppercase !py-4">{tg.ctaSecondaryLabel}</a>
      </div>
      <p class="mt-6 text-sm"><a href={withBase(base, pricingPath)} class="text-accent hover:underline">{tg.pricingLinkLabel}</a></p>
    </div>
  </div>
</section>
