---
// BOLD V1 — Precios con pestañas (compartido ES/EN; texto en
// pricing.<locale>.json). Sin JS se ven todas las secciones una debajo de
// otra; con JS (tabs.ts) se muestran por pestaña. El plan "featured" lleva
// borde dorado giratorio.
import Icon from '../Icon.astro';
import { withBase } from '../../lib/basePath';

interface Props { p: any; base: string }
const { p, base } = Astro.props;

const plansPanels = [
  { id: 'traffic', tag: p.tgTag, icon: p.tgIcon, heading: p.tgHeading, intro: p.tgIntro, plans: p.tgPlans, cta: p.tgCtaLabel, href: p.tgCtaHref, sec: p.tgSecondaryLabel, secHref: p.tgSecondaryHref, notes: [p.tgAdSpendNote, p.tgDisclaimer] },
  { id: 'seo', tag: p.seoTag, icon: p.seoIcon, heading: p.seoHeading, intro: p.seoIntro, plans: p.seoPlans, cta: p.seoCtaLabel, href: p.seoCtaHref, notes: [] },
  { id: 'content', tag: p.contentTag, icon: p.contentIcon, heading: p.contentHeading, intro: p.contentIntro, plans: p.contentPlans, cta: p.contentCtaLabel, href: p.contentCtaHref, sec: p.contentSecondaryLabel, secHref: p.contentSecondaryHref, badge: p.contentBadge, notes: [] },
];
const itemPanels = [
  { id: 'web', tag: p.webTag, icon: p.webIcon, heading: p.webHeading, intro: p.webIntro, items: p.webItems, cta: p.webCtaLabel, href: p.webCtaHref, sec: p.webSecondaryLabel, secHref: p.webSecondaryHref },
  { id: 'brand', tag: p.brandTag, icon: p.brandIcon, heading: p.brandHeading, intro: p.brandIntro, items: p.brandItems, cta: p.brandCtaLabel, href: p.brandCtaHref, sec: p.brandSecondaryLabel, secHref: p.brandSecondaryHref, note: p.brandNote },
];
const quotePanels = [
  { id: 'video', tag: p.videoTag, icon: p.videoIcon, heading: p.videoHeading, body: p.videoBody, cta: p.videoCtaLabel, href: p.videoCtaHref, sec: p.videoSecondaryLabel, secHref: p.videoSecondaryHref },
  { id: 'sub', tag: p.subTag, icon: p.subIcon, heading: p.subHeading, body: p.subBody, chips: p.subFactors, cta: p.subCtaLabel, href: p.subCtaHref, sec: p.subSecondaryLabel, secHref: p.subSecondaryHref },
  { id: 'os', tag: p.osTag, icon: p.osIcon, heading: p.osHeading, body: p.osBody, chips: p.osFeatures, cta: p.osCtaLabel, href: p.osCtaHref, sec: p.osSecondaryLabel, secHref: p.osSecondaryHref },
];
const tabs = [...plansPanels, ...itemPanels, ...quotePanels].map(x => ({ id: x.id, tag: x.tag, icon: x.icon }));
const starts = [p.tgPlans[0]?.price, p.seoPlans[0]?.price, p.webItems[0]?.price].filter(Boolean);
---
<!-- HERO -->
<section class="bg-bg-void relative pt-32 md:pt-40 pb-16 overflow-hidden">
  <div class="grid-drift absolute inset-0 pointer-events-none" aria-hidden="true"></div>
  <div class="glow-breathe absolute -top-48 left-1/2 -translate-x-1/2 w-[46rem] h-[30rem] rounded-full bg-accent/20 blur-[130px] pointer-events-none" aria-hidden="true"></div>
  <div class="relative max-w-container-max mx-auto px-gutter text-center">
    <span class="tag-cyber mb-6 inline-flex items-center gap-2 hero-reveal"><span class="pulse-ring w-2 h-2 rounded-full bg-accent" aria-hidden="true"></span>{p.heroTag}</span>
    <h1 class="hero-reveal uppercase font-display font-extrabold text-text-primary tracking-[-0.03em] leading-[0.98] text-[40px] sm:text-[56px] lg:text-[80px] mb-6 max-w-5xl mx-auto">{p.heroHeading}</h1>
    <p class="hero-reveal text-body-lg text-text-secondary max-w-2xl mx-auto mb-10">{p.heroParagraph}</p>
    <div class="hero-reveal flex flex-wrap justify-center gap-3">
      {starts.map((s, i) => (
        <span class="bob glass rounded-full px-5 py-2.5 font-display uppercase text-sm text-accent" style={`animation-delay:${i * 0.6}s`}>{s}</span>
      ))}
    </div>
  </div>
</section>

<!-- PESTAÑAS -->
<section class="bg-bg-void pb-section-py-sm md:pb-section-py-lg" data-tabs>
  <div class="sticky top-[72px] z-30 bg-bg-void/85 backdrop-blur-xl border-y border-white/10 py-3 mb-12" style="-webkit-backdrop-filter: blur(20px);">
    <div class="max-w-container-max mx-auto px-gutter">
      <div class="flex gap-2 overflow-x-auto no-scrollbar" role="tablist" aria-label={p.tabsLabel}>
        {tabs.map((t, i) => (
          <button type="button" role="tab" data-tab={t.id} aria-selected={i === 0 ? 'true' : 'false'}
            class={`tab-pill shrink-0 inline-flex items-center gap-2 min-h-[44px] px-4 rounded-full border border-white/15 text-text-secondary font-display uppercase text-xs font-bold ${i === 0 ? 'is-active' : ''}`}>
            <Icon name={t.icon} class="text-base" />{t.tag}
          </button>
        ))}
      </div>
    </div>
  </div>

  <div class="max-w-container-max mx-auto px-gutter">
    {plansPanels.map(panel => (
      <div data-panel={panel.id} role="tabpanel" class="tab-panel mb-20">
        <div class="text-center mb-12">
          {panel.badge && <span class="tag-cyber mb-4 inline-flex"><Icon name="bolt" class="text-sm" />{panel.badge}</span>}
          <h2 class="uppercase font-display font-extrabold text-text-primary text-[30px] md:text-[48px] leading-[1.05] mb-4">{panel.heading}</h2>
          <p class="text-text-secondary text-body-md max-w-2xl mx-auto">{panel.intro}</p>
        </div>
        <div class="grid md:grid-cols-3 gap-6 items-stretch">
          {panel.plans.map((plan: any) => (
            <article class={`tilt spot rounded-3xl p-8 flex flex-col ${plan.featured ? 'glow-border bg-bg-depth md:-translate-y-4 shadow-2xl' : 'bg-white/[0.03] border border-white/10'}`} data-tilt="5">
              {plan.featured && <span class="self-start mb-4 rounded-full bg-accent text-bg-void px-3 py-1 text-[11px] font-display uppercase font-bold pulse-ring">{p.featuredLabel}</span>}
              <p class="font-display uppercase font-bold text-xl text-text-primary mb-1">{plan.name}</p>
              <p class="text-text-secondary text-sm mb-6">{plan.sub}</p>
              <p class="font-display font-extrabold text-[40px] leading-none text-accent mb-6">{plan.price}</p>
              <ul class="space-y-2.5 mb-8 flex-1">
                {plan.features.map((f: string) => (
                  <li class="flex items-start gap-2.5 text-sm text-text-secondary">
                    <Icon name="check_circle" class="text-accent text-base mt-0.5 shrink-0" />{f}
                  </li>
                ))}
              </ul>
              <a href={withBase(base, panel.href)} data-booking-trigger class={plan.featured ? 'btn-cyber-solid shine w-full justify-center !py-4' : 'btn-ghost w-full justify-center !py-4'}>
                <span class="uppercase">{panel.cta}</span>{plan.featured && <span class="shine-sweep" aria-hidden="true"></span>}
              </a>
            </article>
          ))}
        </div>
        {(panel.notes.length > 0 || panel.sec) && (
          <div class="mt-8 flex flex-wrap items-center justify-center gap-x-6 gap-y-2 text-sm text-text-dim">
            {panel.notes.filter(Boolean).map((n: string) => <span class="inline-flex items-center gap-1.5"><Icon name="error" class="text-accent text-sm" />{n}</span>)}
            {panel.sec && <a href={withBase(base, panel.secHref)} class="text-accent hover:underline">{panel.sec} →</a>}
          </div>
        )}
      </div>
    ))}

    {itemPanels.map(panel => (
      <div data-panel={panel.id} role="tabpanel" class="tab-panel mb-20">
        <div class="text-center mb-12">
          <h2 class="uppercase font-display font-extrabold text-text-primary text-[30px] md:text-[48px] leading-[1.05] mb-4">{panel.heading}</h2>
          <p class="text-text-secondary text-body-md max-w-2xl mx-auto">{panel.intro}</p>
        </div>
        <div class="max-w-3xl mx-auto flex flex-col gap-3">
          {panel.items.map((it: any, i: number) => (
            <div class="spot group flex items-center justify-between gap-4 rounded-2xl bg-white/[0.03] border border-white/10 px-6 md:px-8 py-5 md:py-6 hover:border-accent/60 hover:bg-white/[0.06] transition-colors">
              <span class="flex items-center gap-4">
                <span class="font-display text-accent/50 text-lg">0{i + 1}</span>
                <span class="font-display uppercase font-bold text-text-primary text-base md:text-lg">{it.name}</span>
              </span>
              <span class="font-display font-extrabold text-accent text-xl md:text-2xl whitespace-nowrap group-hover:scale-110 transition-transform">{it.price}</span>
            </div>
          ))}
        </div>
        {panel.note && <p class="text-center text-sm text-text-dim mt-6 max-w-2xl mx-auto">{panel.note}</p>}
        <div class="mt-8 flex flex-wrap justify-center gap-4">
          <a href={withBase(base, panel.href)} data-booking-trigger class="btn-cyber-solid shine magnetic press"><span class="uppercase">{panel.cta}</span><span class="shine-sweep" aria-hidden="true"></span></a>
          <a href={withBase(base, panel.secHref)} class="btn-ghost magnetic press uppercase">{panel.sec}</a>
        </div>
      </div>
    ))}

    {quotePanels.map(panel => (
      <div data-panel={panel.id} role="tabpanel" class="tab-panel mb-20">
        <div class="glow-border rounded-3xl bg-bg-depth/70 p-10 md:p-14 text-center max-w-4xl mx-auto">
          <span class="bob mx-auto mb-6 w-16 h-16 rounded-2xl bg-accent/15 border border-accent/30 flex items-center justify-center"><Icon name={panel.icon} class="text-accent text-3xl" /></span>
          <h2 class="uppercase font-display font-extrabold text-text-primary text-[28px] md:text-[44px] leading-[1.05] mb-4">{panel.heading}</h2>
          <p class="text-text-secondary text-body-md max-w-2xl mx-auto mb-6">{panel.body}</p>
          {panel.chips && (
            <ul class="flex flex-wrap justify-center gap-2 mb-8">
              {panel.chips.map((c: string) => <li class="rounded-full border border-accent/30 px-4 py-1.5 text-xs font-display uppercase text-text-primary">{c}</li>)}
            </ul>
          )}
          <div class="flex flex-wrap justify-center gap-4">
            <a href={withBase(base, panel.href)} class="btn-cyber-solid shine magnetic press"><span class="uppercase">{panel.cta}</span><span class="shine-sweep" aria-hidden="true"></span></a>
            <a href={withBase(base, panel.secHref)} class="btn-ghost magnetic press uppercase">{panel.sec}</a>
          </div>
        </div>
      </div>
    ))}

    <p class="text-center text-sm text-text-dim inline-flex w-full justify-center items-center gap-2"><Icon name={p.regionIcon} class="text-accent" />{p.regionNote}</p>
  </div>
</section>

<!-- CTA -->
<section class="bg-bg-depth relative py-section-py-sm md:py-section-py-lg overflow-hidden">
  <div class="grid-drift absolute inset-0 pointer-events-none opacity-70" aria-hidden="true"></div>
  <div class="relative max-w-4xl mx-auto px-gutter">
    <div class="glow-border rounded-3xl bg-bg-void/80 p-10 md:p-16 text-center reveal">
      <span class="tag-cyber mb-6 inline-flex">{p.ctaTag}</span>
      <h2 class="uppercase font-display font-extrabold text-text-primary text-[30px] md:text-[52px] leading-[1.02] mb-5">{p.ctaHeading}</h2>
      <p class="text-text-secondary text-body-md max-w-xl mx-auto mb-9">{p.ctaParagraph}</p>
      <div class="flex flex-wrap items-center justify-center gap-4">
        <a href={withBase(base, p.ctaSecondaryHref)} data-booking-trigger class="btn-cyber-solid shine pulse-ring magnetic press !py-4 !px-8">
          <span class="icon-wrap uppercase">{p.ctaButtonLabel} <Icon name={p.ctaButtonIcon} class="text-base" /></span>
          <span class="shine-sweep" aria-hidden="true"></span>
        </a>
        <a href={withBase(base, p.ctaSecondaryHref)} class="btn-ghost magnetic press uppercase !py-4">{p.ctaSecondaryLabel}</a>
      </div>
    </div>
  </div>
</section>
