---
// HOME MOTION V3 — franja dorada en movimiento debajo del hero. La lista
// se duplica para que el loop sea continuo; la copia es aria-hidden.
interface Props { items: string[] }
const { items } = Astro.props;
---
<section class="ticker bg-accent text-bg-void py-3.5 border-y border-accent">
  <div class="ticker-track">
    {[0, 1].map(copy => (
      <ul class="flex shrink-0 items-center" aria-hidden={copy === 1 ? 'true' : undefined}>
        {items.map(item => (
          <li class="flex items-center gap-3 px-6 font-display uppercase font-bold text-sm whitespace-nowrap">
            <span aria-hidden="true">✦</span>{item}
          </li>
        ))}
      </ul>
    ))}
  </div>
</section>
